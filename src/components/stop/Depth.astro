---
// One telling of the stop at one depth. The Depth dial shows one level at a time; all three stay in the HTML for search.
interface Props { level: 'kid' | 'student' | 'engineer' }
const { level } = Astro.props;
---
<div class="depth" data-depth={level}><slot /></div>

<style>
  .depth { display: none }
  .depth > :global(* + *) { margin-top: var(--s3) }
  .depth :global(p), .depth :global(ul), .depth :global(ol) { max-width: var(--read) }
  .depth :global(ul) { list-style: disc; padding-left: 1.2rem }
  .depth :global(ol) { list-style: decimal; padding-left: 1.2rem }
  :global(main:has([name="depth"][value="kid"]:checked)) [data-depth="kid"],
  :global(main:has([name="depth"][value="student"]:checked)) [data-depth="student"],
  :global(main:has([name="depth"][value="engineer"]:checked)) [data-depth="engineer"] { display: block }
</style>

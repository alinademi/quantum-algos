<qce-gaussian-quadrature class="tool">
 <div class="tool-controls controls">
  <label>Squeezing r <select data-r><option>0</option><option>0.3</option><option>0.7</option><option>1</option></select></label>
  <label>Rotation (degrees) <select data-t><option>0</option><option>45</option><option>90</option><option>135</option></select></label>
  <label>Displacement <select data-d><option>0</option><option>1</option><option>2</option><option>-1</option></select></label>
  <button type="button" class="btn" data-run>Measure fresh copies</button>
 </div>
 <canvas aria-hidden="true"></canvas>
 <p class="tool-readout" aria-live="polite"></p>
 <p class="note">Each dot is one quadrature measurement of a fresh mode. The x and p rows use separate copies; they are not simultaneous measurements. Clipped extremes are counted at the endpoints. This is an ideal pure Gaussian model.</p>
</qce-gaussian-quadrature>
<script>
 import {gaussian,quadratureShots} from '../../lib/sims/cv-model.ts';
 import {fit,palette,dot,onResize,onTheme,onSeen} from '../../lib/draw.ts';
 class GaussianQuadrature extends HTMLElement{
  connectedCallback(){
   const $=(s:string)=>this.querySelector<HTMLSelectElement>(s)!,r=$('[data-r]'),t=$('[data-t]'),d=$('[data-d]'),canvas=this.querySelector('canvas')!,read=this.querySelector('.tool-readout')!;let seen=true,results:number[][]=[];
   const state=()=>gaussian(+r.value,+t.value*Math.PI/180,+d.value);
   const draw=()=>{if(!seen)return;const {ctx,w,h}=fit(canvas);if(w<40)return;const p=palette();ctx.clearRect(0,0,w,h);const n=40,width=w-32,pitch=width/n;
    results.forEach((values,i)=>{const bins=Array(n).fill(0);values.forEach(v=>bins[Math.min(n-1,Math.max(0,Math.floor((v+8)/16*n)))]++);const base=(i+1)*h/2-22,max=Math.max(...bins),dy=Math.min(4,(h/2-48)/max);ctx.fillStyle=p.ink;ctx.font='12px monospace';ctx.textAlign='left';ctx.fillText(i?'p measurements':'x measurements',16,i*h/2+14);bins.forEach((k,j)=>{for(let a=0;a<k;a++)dot(ctx,16+(j+.5)*pitch,base-(a+.5)*dy,Math.min(2,pitch*.36,dy*.4),i?p.hot:p.signal);});ctx.fillStyle=p.ink;ctx.fillText('−8',16,base+14);ctx.textAlign='right';ctx.fillText('+8',w-16,base+14);});
   };
   const update=()=>{const s=state();results=[quadratureShots(s.x,s.vx,400,Math.random),quadratureShots(s.p,s.vp,400,Math.random)];read.textContent='Started as vacuum. After squeeze, displacement and rotation: mean x '+s.x.toFixed(3)+', p '+s.p.toFixed(3)+'; variance x '+s.vx.toFixed(3)+', p '+s.vp.toFixed(3)+'; covariance '+s.cov.toFixed(3)+', determinant '+(s.vx*s.vp-s.cov*s.cov).toFixed(3)+'; uncertainty product '+Math.sqrt(s.vx*s.vp).toFixed(3)+'. 400 fresh shots per quadrature.';draw();};
   for(const e of [r,t,d])e.addEventListener('change',update);this.querySelector('button')!.addEventListener('click',update);onResize(this,draw);onTheme(draw);onSeen(this,v=>{seen=v;if(v)draw();});update();
  }
 }
 customElements.define('qce-gaussian-quadrature',GaussianQuadrature);
</script>
<style>qce-gaussian-quadrature{display:grid;gap:var(--s3)}.controls{display:flex;flex-wrap:wrap;gap:var(--s2)}label{display:grid;flex:1 1 6rem}select{min-height:2.75rem;background:var(--paper);color:var(--ink);font:inherit}canvas{width:100%;height:18rem}.note{color:var(--ink-2);font-size:.875rem}</style>

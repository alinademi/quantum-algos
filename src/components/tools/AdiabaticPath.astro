<qce-adiabatic-path class="tool">
 <div class="tool-controls"><label>Total evolution time (ħ = 1) <select><option>1</option><option>5</option><option>20</option><option>50</option><option>100</option></select></label></div>
 <canvas aria-hidden="true"></canvas>
 <p class="tool-readout" aria-live="polite"></p>
 <details><summary>Exact numerical path values</summary><dl></dl></details>
 <p class="note">Plot, not shot counts: points are numerical ground-state probabilities at ten equal path intervals. The gap is smallest at the middle. Final overlap alone does not establish adiabatic following.</p>
</qce-adiabatic-path>
<script>
 import {path} from '../../lib/sims/adiabatic.ts';
 import {fit,palette,onResize,onSeen,onTheme,dot,pct} from '../../lib/draw.ts';
 class AdiabaticPath extends HTMLElement{
  connectedCallback(){
   const input=this.querySelector('select')!,canvas=this.querySelector('canvas')!,read=this.querySelector('.tool-readout')!,dl=this.querySelector('dl')!;let samples=path(+input.value),seen=true;
   const draw=()=>{if(!seen)return;const {ctx,w,h}=fit(canvas);if(w<40)return;const p=palette(),left=36,top=26,right=w-12,bottom=h-28,x=(s:number)=>left+s*(right-left),y=(v:number)=>bottom-v*(bottom-top);
    ctx.clearRect(0,0,w,h);ctx.strokeStyle=p.rule;ctx.fillStyle=p.ink2;ctx.font='12px monospace';ctx.textAlign='right';
    for(const v of [0,.5,1]){ctx.beginPath();ctx.moveTo(left,y(v));ctx.lineTo(right,y(v));ctx.stroke();ctx.fillText(String(v),left-5,y(v)+4);}
    ctx.textAlign='left';ctx.fillText('Ground-state probability',left,13);ctx.fillText('0',left,bottom+18);ctx.textAlign='right';ctx.fillText('s = 1',right,bottom+18);
    ctx.strokeStyle=p.signal;ctx.lineWidth=2;ctx.beginPath();samples.forEach((v,i)=>i?ctx.lineTo(x(v.s),y(v.ground)):ctx.moveTo(x(v.s),y(v.ground)));ctx.stroke();samples.forEach(v=>dot(ctx,x(v.s),y(v.ground),3,p.signal));
   };
   const update=()=>{samples=path(+input.value);const min=Math.min(...samples.map(v=>v.ground));read.textContent='Started as |+⟩. T = '+input.value+': final ground-state probability '+pct(samples.at(-1)!.ground)+', smallest sampled probability '+pct(min)+'. Minimum energy gap √2.';dl.replaceChildren(...samples.map(v=>{const d=document.createElement('div'),dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent='s = '+v.s.toFixed(1);dd.textContent='Ground '+v.ground.toFixed(6)+'; gap '+v.gap.toFixed(4);d.append(dt,dd);return d;}));draw();};
   input.addEventListener('change',update);onResize(this,draw);onTheme(draw);onSeen(this,v=>{seen=v;if(v)draw();});update();
  }
 }
 customElements.define('qce-adiabatic-path',AdiabaticPath);
</script>
<style>qce-adiabatic-path{display:grid;gap:var(--s3)}canvas{width:100%;height:13rem}select{min-height:2.75rem;font:inherit;color:var(--ink);background:var(--paper)}dl{display:grid;gap:var(--s2)}dd{margin:0}.note{color:var(--ink-2);font-size:.875rem}</style>

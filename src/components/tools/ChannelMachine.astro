---
// One qubit through a machine made of Kraus operators: where the state goes, the doors it can take, whether the operators
// are a channel (sum of K†K = I), and the pair test that separates completely positive maps from merely positive ones.
// Ideal maps, exact math. Real-amplitude start states only, so everything lives in the x-z plane of the Bloch ball.
import { KINDS, CHANNELS, SHOTS, THETA, krausOps, jumps, chanceText, describe, valueText, valueShort, pairVerdict, num, type Kind } from '../../lib/sims/channels.ts';
const uid = 'cm-' + Math.random().toString(36).slice(2, 8);
const K0: Kind = 'flip', V0 = CHANNELS[K0].start, T0 = THETA.start;
const ops0 = krausOps(K0, V0)!, js0 = jumps(K0, V0, T0), ve0 = pairVerdict(K0, V0);
---
<qce-channel-machine class="tool">
  <div class="cols">
    <canvas class="disk" aria-hidden="true"></canvas>

    <div class="tool-controls">
      <fieldset>
        <legend class="label">The map</legend>
        <div class="choices">
          {KINDS.map((k) => (
            <label><input type="radio" name={`${uid}-k`} value={k} data-k checked={k === K0} />{CHANNELS[k].name}</label>
          ))}
        </div>
        <p class="what" data-what>{CHANNELS[K0].what}</p>
        <div class="slider">
          <div class="row"><label for={`${uid}-v`} data-vlabel>{CHANNELS[K0].slider}</label><output for={`${uid}-v`} data-out="v">{valueShort(K0, V0)}</output></div>
          <input id={`${uid}-v`} name="v" type="range" min={CHANNELS[K0].min} max={CHANNELS[K0].max} step={CHANNELS[K0].step} value={V0} aria-valuetext={valueText(K0, V0)} />
        </div>
      </fieldset>

      <div class="slider">
        <div class="row"><label for={`${uid}-t`}>Start state: RY turn from 0</label><output for={`${uid}-t`} data-out="t">{T0}°</output></div>
        <input id={`${uid}-t`} name="t" type="range" min={THETA.min} max={THETA.max} step={THETA.step} value={T0} aria-valuetext={`${T0} degrees`} />
      </div>

      <div class="ops-box">
        <p class="label">The operators, and the chance each one acts</p>
        <ul class="ops" data-ops>
          {ops0.map((o, i) => <li><code>{o.name} = {o.text}</code><span>{chanceText(js0.find((j) => j.k === i)?.p ?? 0)}</span></li>)}
        </ul>
        <p class="sum" data-sum>Sum of K†K: <code>I</code></p>
      </div>

      <button type="button" class="btn btn-sm btn-line again">Run {SHOTS} new shots</button>
    </div>

    <div class="pair">
      <canvas class="bars" aria-hidden="true"></canvas>
      <p class="pair-line" data-pair>Lowest eigenvalue: <code>{num(ve0.low, 3)}</code>. {ve0.state ? 'A state.' : 'Not a state.'}</p>
    </div>

    <p class="key">Left: the Bloch ball cut through its middle. The ring is the start state. The small dots are shots: each is the state left by the operator that acted, so places that repeat look darker. The large dot is the exact output, which is the average of the shots, and the line runs from the center to it. The faint dots outline where the map sends every state on the circle. A different set of operators can give the same map, with other shots and the same average, so the shots are one way to read the map, not the map itself, and a label K₀, K₁ need not be one physical event. A map that loses shots is not a channel: lost shots have no dot, and the state shown is rescaled to trace 1. You can start only from real amplitudes: one circle through |0⟩, |+⟩, |1⟩ and |−⟩, in steps of 5 degrees. Every map here sends that plane into itself, so this one picture shows what happens to these start states. Right: the pair test. The same map acts on one qubit of the entangled pair (|00⟩ + |11⟩)/√2 while the other qubit is left alone. Each bar is one eigenvalue of the result, largest first. A real state has no bar below the zero line. Numbers are rounded.</p>
  </div>

  <p class="tool-readout" aria-live="polite">{describe(K0, V0, T0)}</p>
</qce-channel-machine>

<script>
  import {
    KINDS, CHANNELS, SHOTS, krausOps, jumps, batch, tally, output, circleImage, pairEigenvalues, pairVerdict, completeness, keepsTrace,
    startPoint, chanceText, describe, valueText, valueShort, num, type Kind, type Jump, type Pt, type Op,
  } from '../../lib/sims/channels.ts';
  import { fit, palette, token, reduceMotion, onResize, onTheme, onSeen, dot } from '../../lib/draw.ts';

  const FILL = 700; // ms for a new batch of shots to arrive

  class ChannelMachine extends HTMLElement {
    connectedCallback() {
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s)!;
      const disk = $<HTMLCanvasElement>('canvas.disk'), bars = $<HTMLCanvasElement>('canvas.bars');
      const vIn = $<HTMLInputElement>('input[name="v"]'), tIn = $<HTMLInputElement>('input[name="t"]');
      const vOut = $('[data-out="v"]'), tOut = $('[data-out="t"]'), vLabel = $('[data-vlabel]'), what = $('[data-what]');
      const opsEl = $('[data-ops]'), sumEl = $('[data-sum]'), pairEl = $('[data-pair]');
      const readout = $('.tool-readout'), again = $<HTMLButtonElement>('.again');
      const kinds = [...this.querySelectorAll<HTMLInputElement>('[data-k]')];

      let dctx: CanvasRenderingContext2D | null = null, dw = 0, dh = 0, bctx: CanvasRenderingContext2D | null = null, bw = 0, bh = 0;
      let col = palette();
      let kind = (kinds.find((r) => r.checked)?.value ?? 'flip') as Kind;
      // Each map remembers its own slider.
      const vals = Object.fromEntries(KINDS.map((k) => [k, CHANNELS[k].start])) as Record<Kind, number>;
      let theta = Number(tIn.value);
      // One fixed uniform draw per shot, so a batch stays the same batch while the sliders move.
      let us = Array.from({ length: SHOTS }, () => Math.random());
      let js: Jump[] = [], picks: number[] = [], image: Pt[] = [], eig: number[] = [];
      let out: Pt | null = null, shown = SHOTS, ran = false, seen = false, anim = 0, pending = 0;

      const at = (p: Pt, cx: number, cy: number, R: number): [number, number] => [cx + R * p[0], cy - R * p[1]];

      function drawDisk() {
        if (!dctx || !dw) return;
        const g = dctx, cx = dw / 2, cy = dh / 2, R = Math.min(dw, dh) / 2 - 38;
        g.clearRect(0, 0, dw, dh);
        // The circle and the two axes: drawing only.
        for (let i = 0; i < 120; i++) dot(g, cx + R * Math.cos((i * Math.PI) / 60), cy + R * Math.sin((i * Math.PI) / 60), 1.1, col.ink2);
        g.globalAlpha = 0.6;
        for (let i = -20; i <= 20; i++) { dot(g, cx + (R * i) / 20, cy, 0.8, col.rule); dot(g, cx, cy - (R * i) / 20, 0.8, col.rule); }
        // Where the map sends the whole circle.
        g.globalAlpha = 0.55;
        for (const p of image) { const [x, y] = at(p, cx, cy, R); dot(g, x, y, 1.8, col.signal); }
        // The shots: one dot each, at the state left by the operator that acted. Repeats darken.
        g.globalAlpha = 0.22;
        for (let i = 0; i < shown; i++) if (picks[i] >= 0) { const [x, y] = at(js[picks[i]].point, cx, cy, R); dot(g, x, y, 3.4, col.ink); }
        g.globalAlpha = 1;
        // The start state (ring) and the exact output (large dot, with its arrow from the center).
        const [sx, sy] = at(startPoint(theta), cx, cy, R);
        if (out) {
          const [ox, oy] = at(out, cx, cy, R);
          g.strokeStyle = col.signal; g.lineWidth = 1.5; g.beginPath(); g.moveTo(cx, cy); g.lineTo(ox, oy); g.stroke();
          dot(g, ox, oy, 8, col.plate); dot(g, ox, oy, 6, col.signal);
        }
        g.strokeStyle = col.ink; g.lineWidth = 1.75; g.beginPath(); g.arc(sx, sy, 8.5, 0, Math.PI * 2); g.stroke();
        // Labels for the four states at the ends of the axes.
        g.font = `500 12px ${token('--mono')}`; g.fillStyle = col.ink; g.textBaseline = 'middle';
        g.textAlign = 'center'; g.fillText('|0⟩', cx, cy - R - 20); g.fillText('|1⟩', cx, cy + R + 20);
        g.textAlign = 'left'; g.fillText('|+⟩', cx + R + 14, cy);
        g.textAlign = 'right'; g.fillText('|−⟩', cx - R - 14, cy);
      }

      function drawBars() {
        if (!bctx || !bw) return;
        const g = bctx, top = 22, bottom = 26, left = 34, lo = -0.5, hi = 1;
        const sc = (bh - top - bottom) / (hi - lo), y0 = top + hi * sc;
        const cols = eig.length, pitch = (bw - left - 8) / cols;
        g.clearRect(0, 0, bw, bh);
        g.font = `500 11px ${token('--mono')}`; g.textBaseline = 'middle';
        // The zero line, dotted, and the tick labels.
        for (let x = left; x < bw - 4; x += 6) dot(g, x, y0, 0.9, col.ink2);
        g.fillStyle = col.ink2; g.textAlign = 'right';
        g.fillText('0', left - 6, y0); g.fillText('1', left - 6, y0 - sc); g.fillText('−0.5', left - 6, y0 + 0.5 * sc);
        for (let x = left; x < bw - 4; x += 6) dot(g, x, y0 - sc, 0.6, col.rule);
        eig.forEach((v, i) => {
          const x = left + pitch * (i + 0.5), neg = v < -1e-9, color = neg ? col.hot : col.signal;
          const n = Math.floor(Math.abs(v) / 0.1);
          for (let k = 1; k <= n; k++) dot(g, x, y0 - Math.sign(v) * k * 0.1 * sc, 1.9, color);
          dot(g, x, y0 - v * sc, 4.5, color);
          g.fillStyle = col.ink; g.textAlign = 'center';
          g.fillText(num(v, 2), x, neg ? y0 - v * sc + 13 : y0 - v * sc - 11);
        });
      }

      const draw = () => { drawDisk(); drawBars(); };
      const redraw = () => { if (!pending) pending = requestAnimationFrame(() => { pending = 0; draw(); }); };
      const stop = () => { if (anim) { cancelAnimationFrame(anim); anim = 0; } shown = SHOTS; };

      const renderOps = (ops: Op[] | null) => {
        opsEl.replaceChildren();
        if (!ops) {
          const li = document.createElement('li'); li.textContent = 'No set of operators gives this map.'; opsEl.append(li);
          sumEl.textContent = 'There is nothing to sum.'; return;
        }
        ops.forEach((o, i) => {
          const li = document.createElement('li'), code = document.createElement('code'), span = document.createElement('span');
          code.textContent = `${o.name} = ${o.text}`; span.textContent = chanceText(js.find((j) => j.k === i)?.p ?? 0);
          li.append(code, span); opsEl.append(li);
        });
        const tot = completeness(ops);
        sumEl.textContent = keepsTrace(ops) ? 'Sum of K†K = I: the chances add to 1.' : `Sum of K†K = diag(${num(tot[0][0].re)}, ${num(tot[1][1].re)}), not I: not a channel, one kept branch.`;
      };

      // New settings: recompute the picture and the numbers. The spoken readout is left to say().
      const show = () => {
        stop();
        const v = vals[kind], ops = krausOps(kind, v), res = output(kind, v, theta), ve = pairVerdict(kind, v);
        js = jumps(kind, v, theta); picks = batch(js, us); image = circleImage(kind, v); out = res.point; eig = pairEigenvalues(kind, v);
        const c = CHANNELS[kind];
        vIn.min = String(c.min); vIn.max = String(c.max); vIn.step = String(c.step); vIn.value = String(v);
        vOut.textContent = valueShort(kind, v); vIn.setAttribute('aria-valuetext', valueText(kind, v));
        vLabel.textContent = c.slider; what.textContent = c.what;
        tIn.value = String(theta); tOut.textContent = `${theta}°`; tIn.setAttribute('aria-valuetext', `${theta} degrees`);
        renderOps(ops);
        again.disabled = !ops;
        pairEl.textContent = `Lowest eigenvalue: ${num(ve.low, 3)}. ${!ve.state ? 'Not a state.' : ve.keeps ? 'A state.' : 'Not a state with trace 1: the total is ' + num(ve.sum) + '. No negative bar, so the map is completely positive, but not a channel.'}`;
        ran = false;
        draw();
      };
      const say = () => {
        const v = vals[kind];
        readout.textContent = describe(kind, v, theta, ran && shown === SHOTS ? tally(js, picks) : undefined);
      };

      // A new batch arrives shot by shot, unless the reader asked for less motion or the tool is off screen.
      const measure = () => {
        stop();
        us = us.map(() => Math.random());
        picks = batch(js, us); ran = true;
        if (reduceMotion() || !seen) { draw(); say(); return; }
        shown = 0;
        const t0 = performance.now();
        const step = (now: number) => {
          shown = Math.min(SHOTS, Math.floor(((now - t0) / FILL) * SHOTS));
          draw();
          if (shown < SHOTS) anim = requestAnimationFrame(step); else { anim = 0; say(); }
        };
        anim = requestAnimationFrame(step);
      };

      kinds.forEach((r) => r.addEventListener('change', () => { if (r.checked) { kind = r.value as Kind; show(); say(); } }));
      vIn.addEventListener('input', () => { vals[kind] = Number(vIn.value); show(); });
      tIn.addEventListener('input', () => { theta = Number(tIn.value); show(); });
      // Say the new setup once the reader lets go, not at every step of a drag.
      vIn.addEventListener('change', say);
      tIn.addEventListener('change', say);
      again.addEventListener('click', measure);

      const sizeDisk = () => { ({ ctx: dctx, w: dw, h: dh } = fit(disk)); drawDisk(); };
      const sizeBars = () => { ({ ctx: bctx, w: bw, h: bh } = fit(bars)); drawBars(); };
      onResize(disk, sizeDisk); onResize(bars, sizeBars);
      onTheme(() => { col = palette(); draw(); });
      // Off screen, a batch in flight lands at once and is read out.
      onSeen(this, (v) => { seen = v; if (!v && anim) { stop(); draw(); say(); } });
      sizeDisk(); sizeBars(); show(); say();
    }
  }
  customElements.define('qce-channel-machine', ChannelMachine);
</script>

<style>
  qce-channel-machine { display: grid; container-type: inline-size }
  /* Narrow: the ball, the controls, the pair test, then the key. Wide: the ball and the pair test on the left, controls right. */
  .cols { display: grid; gap: var(--s4); min-width: 0; grid-template-areas: "disk" "ctl" "pair" "key" }
  canvas { display: block; width: 100%; touch-action: pan-y }
  .disk { grid-area: disk; aspect-ratio: 1; max-width: 24rem; justify-self: center }
  .pair { grid-area: pair; display: grid; gap: var(--s2); min-width: 0; max-width: 24rem; justify-self: center; width: 100% }
  .bars { aspect-ratio: 8 / 5 }
  .pair-line { font-size: .9375rem; color: var(--ink-2) }
  .key { grid-area: key; font-size: .875rem; color: var(--ink-2); max-width: var(--read) }
  .tool-controls { grid-area: ctl; display: grid; gap: var(--s4); align-content: start; align-items: start; min-width: 0 }
  fieldset { display: grid; gap: var(--s3); min-width: 0; margin: 0; padding: 0; border: 0 }
  legend { padding: 0; margin-bottom: var(--s2) }
  .choices { display: flex; flex-wrap: wrap; gap: var(--s2) }
  .choices label { display: inline-flex; align-items: center; gap: var(--s2); min-height: 2.75rem; padding: 0 var(--s3); border: 1.5px solid var(--rule); border-radius: var(--r); background: var(--paper); color: var(--ink); font-weight: 500; cursor: pointer }
  .choices label:hover { border-color: var(--ink) }
  .choices label:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink) }
  .choices input { flex: none; width: 1.125rem; height: 1.125rem; margin: 0; accent-color: var(--signal) }
  .what { font-size: .9375rem; color: var(--ink-2); max-width: var(--read); min-height: 4.5em }
  .slider { display: grid; gap: var(--s1); min-width: 0 }
  .slider input { width: 100%; min-height: 1.75rem; margin: 0; accent-color: var(--signal) }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s2) }
  .row output { flex: none; font-size: 1.25rem }
  .ops-box { display: grid; gap: var(--s2); min-width: 0 }
  .ops { display: grid; gap: var(--s1); margin: 0; padding: 0; list-style: none }
  .ops :global(li) { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); padding: var(--s1) 0; border-bottom: 1px dotted var(--rule) }
  .ops :global(code) { font-size: .9375rem; overflow-wrap: anywhere }
  .ops :global(span) { flex: none; font: 500 1rem var(--mono) }
  .sum { font-size: .9375rem; color: var(--ink-2) }
  .again { justify-self: start }
  .tool-readout { min-height: 16em }
  @container (min-width: 38rem) {
    .cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto 1fr; grid-template-areas: "disk ctl" "pair ctl" "key ctl"; column-gap: var(--s5); align-items: start }
    .disk, .pair { max-width: none }
    .tool-readout { min-height: 10em }
  }
</style>

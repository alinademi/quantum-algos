---
// One two-slit run, told five ways. Every dot is one Born-rule shot of the same wave (model units, hbar = m = 1). The four stories that
// keep the standard rules read each shot's random number the same way, so they put every dot in the same place; only the collapse story
// (GRW, real units) changes the odds, and only for large objects. All numbers come from interpretations.ts, which is tested.
import { STORIES, SIZES, CAP, BATCH, screenTable, brightShares, brightShare, strength, describe, sizeText, percent } from '../../lib/sims/interpretations.ts';
const uid = 'fs-' + Math.random().toString(36).slice(2, 8);
const story0 = STORIES[0].id, shares0 = brightShares(screenTable()), v0 = strength(story0, 10 ** SIZES.start);
---
<qce-five-stories class="tool">
  <fieldset class="stories">
    <legend>Story</legend>
    <div class="opts">
      {STORIES.map((s) => (
        <label><input type="radio" name={`${uid}-story`} value={s.id} checked={s.id === story0} />{s.name}</label>
      ))}
    </div>
  </fieldset>

  <figure>
    <canvas aria-hidden="true"></canvas>
    <figcaption>
      <span class="key">
        <span class="kw">the wave: bigger dot, more of the odds</span><span class="kc">odds this story predicts</span><span class="kb">bright bands</span>
      </span>
      <span data-extra></span>
      <span>Top: the wall with two slits. Below it, the wave on its way to the screen, drawn as dots; each row is scaled to its own biggest dot. Bottom: the screen, one dot for each shot. The picture is a model, not to scale, with slits as two starting packets.</span>
    </figcaption>
  </figure>

  <dl class="stats">
    <div><dt>Dots so far</dt><dd data-count>0</dd></div>
    <div><dt>In the bright bands</dt><dd data-got>none yet</dd></div>
    <div><dt>This story predicts</dt><dd data-pred>{percent(brightShare(v0, shares0))}</dd></div>
    <div><dt>Stripes keep</dt><dd data-keep>{percent(v0)}</dd></div>
  </dl>

  <div class="control">
    <div class="row">
      <label for={`${uid}-size`}>Size of the object</label>
      <output for={`${uid}-size`} aria-live="off" data-size-out>{sizeText(SIZES.start)}</output>
    </div>
    <input id={`${uid}-size`} data-size type="range" min={SIZES.min} max={SIZES.max} step={SIZES.step} value={SIZES.start}
      aria-valuetext={sizeText(SIZES.start)} aria-describedby={`${uid}-size-hint`} />
    <p class="hint" id={`${uid}-size-hint`}>Standard quantum mechanics predicts full stripes at any size, if the object is cut off from its surroundings. The collapse model predicts that the stripes fade as the object gets bigger. The slider changes the numbers only for the collapse story.</p>
  </div>

  <div class="tool-controls">
    <button class="btn btn-sm" type="button" data-fire="1">Fire 1 shot</button>
    <button class="btn btn-sm" type="button" data-fire={BATCH}>Fire {BATCH} shots</button>
    <button class="btn btn-sm btn-line" type="button" data-clear>Clear</button>
  </div>

  <p class="tool-readout" aria-live="polite">{describe(story0, SIZES.start, { shots: 0, inBright: 0 }, shares0)}</p>
  <p class="note">A simulation. Each shot sends one object at two slits with equal amplitudes for the two. The picture is in model units: two starting packets at the slits, spreading freely, with the wave drawn as dots and the screen's odds taken from it by the Born rule. The collapse numbers are in real units: GRW's original rate, one hit per particle about every 10¹⁶ seconds, and hit width 10⁻⁷ m, with the thought experiment that the two paths stay more than that apart for 1 second. A hit picks one path; with no hit the whole wave reaches the screen. Each shot has one random number for where it lands. The stories that keep the standard rules read it the same way, so switching between them never moves a dot: that shows they agree on the odds, not that a hidden number sits behind a Copenhagen-style dot. In the pilot-wave story the number is the starting place. The picture holds {CAP.toLocaleString('en')} dots. The view stops at the edge; a dot past it is counted but not drawn (fewer than 1 in 1,000). Dots are drawn by your browser's random numbers. The model is one dimension across the screen, and the pilot-wave paths are a sketch of that model, not of a real wall.</p>
</qce-five-stories>

<script>
  import {
    VIEW, T, ROWS, LEFT, RIGHT, APART, APART_PICTURE, CAP, newShot, land, startOf, branches, screenTable, rowTables,
    path, pattern, brightBands, brightShares, bright, strength, describe, sizeText, percent, cdfAt, brightShare,
    type Story, type Shot, type Landing, type Table,
  } from '../../lib/sims/interpretations.ts';
  import { fit, palette, token, reduceMotion, onResize, onTheme, onSeen, dot } from '../../lib/draw.ts';

  /** How long a new dot stays big and blue, in ms. How many dots a big press adds each second. How many paths the pilot-wave story keeps drawn. */
  const FRESH = 450, RATE = 90, PATHS = 25;
  /** Every STEP-th row of the tables is a row of the wave picture. */
  const STEP = 3;
  type Rec = { shot: Shot; x0: number; landing: Landing; t: number; path?: number[] };

  const KEYS: Record<Story, string> = {
    rule: '',
    collapse: 'Squares: dots from objects that got a hit. Red ring: where the last hit came. The red bracket is the 1 second the thought experiment keeps the paths apart (drawn on the first stretch of the flight; picture only).',
    copenhagen: '',
    'many-worlds': 'Filled dot: this branch. Rings: a few of the other branches, drawn as equal slices of the weight.',
    'pilot-wave': 'Blue lines: the paths of the last shots. Each starts at a slit and ends at its dot.',
    qbism: '',
  };

  class FiveStories extends HTMLElement {
    connectedCallback() {
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s)!;
      const canvas = $<HTMLCanvasElement>('canvas'), readout = $('.tool-readout'), extra = $('[data-extra]');
      const radios = [...this.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
      const sizeIn = $<HTMLInputElement>('[data-size]'), sizeOut = $('[data-size-out]');
      const countOut = $('[data-count]'), gotOut = $('[data-got]'), predOut = $('[data-pred]'), keepOut = $('[data-keep]');
      const fires = [...this.querySelectorAll<HTMLButtonElement>('[data-fire]')], clearBtn = $<HTMLButtonElement>('[data-clear]');

      const screen: Table = screenTable(), shares = brightShares(screen);
      let tabs: Table[] | null = null;
      const rows = () => (tabs ??= rowTables(2000, screen));
      let story: Story = (radios.find((r) => r.checked)?.value ?? 'rule') as Story, k = Number(sizeIn.value);
      let recs: Rec[] = [], queue = 0, acc = 0, raf = 0, last = 0, seen = false, lastLand = -Infinity;
      let ctx = canvas.getContext('2d')!, pal = palette(), mono = token('--mono');
      // Layout and the wave picture for the current canvas width.
      type Layout = { w: number; h: number; pad: number; top: number; waveH: number; bandTop: number; bandH: number; ppu: number; cols: number };
      let L: Layout | null = null;
      let imageCols = 0, image: { j: number; i: number; r: number }[] = [], curve: number[] = [], pmax = 1, bands: [number, number][] = [];

      const layout = (w: number): Layout => {
        const pad = 10, h = Math.round(Math.min(520, Math.max(360, w * 0.95))), top = 30, bandH = 84, axis = 24;
        return { w, h, pad, top, waveH: h - top - bandH - axis - 12, bandTop: h - bandH - axis, bandH, ppu: (w / 2 - pad) / VIEW, cols: Math.max(24, Math.floor((w - 2 * pad) / 5)) };
      };
      const X = (x: number) => L!.w / 2 + x * L!.ppu;
      const Y = (t: number) => L!.top + (L!.waveH * t) / T;

      // ---- What the story gives

      const size = () => 10 ** k;
      const relabel = () => { for (const r of recs) r.landing = land(story, size(), r.shot, screen); };
      const lastRec = () => (recs.length ? { x0: recs[recs.length - 1].x0, landing: recs[recs.length - 1].landing } : null);
      const counts = () => ({ shots: recs.length, inBright: recs.reduce((n, r) => n + (bright(r.landing.x) ? 1 : 0), 0) });
      const v = () => strength(story, size());

      // The wave picture: a row of cells, each with the share of the odds that falls in it.
      const buildImage = () => {
        if (!L || (!tabs && !seen)) return;
        const t = rows(), { cols } = L, half = VIEW, cell = (2 * half) / cols;
        image = []; imageCols = cols;
        for (let j = 0; j <= ROWS; j += STEP) {
          const m: number[] = [];
          let top = 0;
          for (let i = 0; i < cols; i++) { const a = -half + i * cell, p = cdfAt(t[j], a + cell) - cdfAt(t[j], a); m.push(p); if (p > top) top = p; }
          for (let i = 0; i < cols; i++) if (m[i] > top * 0.01) image.push({ j, i, r: Math.sqrt(m[i] / top) });
        }
      };

      const buildCurve = () => {
        if (!L) return;
        const n = 160, c: number[] = [];
        pmax = 0;
        for (let i = 0; i <= n; i++) pmax = Math.max(pmax, pattern(-VIEW + (2 * VIEW * i) / n, 1));
        const val = v();
        for (let i = 0; i <= n; i++) c.push(pattern(-VIEW + (2 * VIEW * i) / n, val) / pmax);
        curve = c;
        bands = brightBands(-VIEW, VIEW);
      };

      // ---- Drawing

      const text = (s: string, x: number, y: number, align: CanvasTextAlign, color: string, weight = 500) => {
        ctx.font = `${weight} 11px ${mono}`; ctx.textAlign = align; ctx.textBaseline = 'middle'; ctx.fillStyle = color; ctx.fillText(s, x, y);
      };
      const ring = (x: number, y: number, r: number, color: string, wd = 1.5) => {
        ctx.strokeStyle = color; ctx.lineWidth = wd; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.stroke();
      };
      const dotY = (r: Rec) => L!.bandTop + 5 + r.shot.lift * (L!.bandH - 10);

      const paint = (now = performance.now()) => {
        if (!L) return;
        if (tabs && imageCols !== L.cols) buildImage();
        const { w, h, pad, top, waveH, bandTop, bandH, cols } = L;
        ctx.clearRect(0, 0, w, h);

        // The wall with two slits.
        const wy = top - 8, gap = 1.6;
        ctx.strokeStyle = pal.ink; ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(pad, wy); ctx.lineTo(X(LEFT - gap), wy);
        ctx.moveTo(X(LEFT + gap), wy); ctx.lineTo(X(RIGHT - gap), wy);
        ctx.moveTo(X(RIGHT + gap), wy); ctx.lineTo(w - pad, wy);
        ctx.stroke();
        text('slits', pad, wy - 10, 'left', pal.ink2, 600);

        // The wave, as dots: bigger dot, bigger share of the odds in that slice of the row.
        const cell = ((w - 2 * pad) / cols), rowH = (waveH * STEP) / ROWS, rmax = Math.max(1, Math.min(cell, rowH) * 0.46);
        ctx.fillStyle = pal.ink2; ctx.globalAlpha = 0.55;
        for (const d of image) {
          const x = pad + (d.i + 0.5) * cell, y = Y(d.j * (T / ROWS));
          ctx.beginPath(); ctx.arc(x, y, Math.max(0.5, rmax * d.r), 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;

        // Story extras on the wave.
        const latest = recs[recs.length - 1];
        if (story === 'pilot-wave' && tabs) {
          const shown = recs.slice(-PATHS);
          shown.forEach((r, n) => {
            const p = (r.path ??= path(tabs!, r.shot.place));
            const newest = n === shown.length - 1;
            ctx.strokeStyle = pal.signal; ctx.globalAlpha = newest ? 1 : 0.35; ctx.lineWidth = newest ? 2 : 1; ctx.lineJoin = 'round';
            ctx.beginPath();
            p.forEach((x, j) => { const px = X(x), py = Y(j * (T / ROWS)); if (j) ctx.lineTo(px, py); else ctx.moveTo(px, py); });
            ctx.stroke();
            if (newest) ring(X(p[0]), Y(0), 3.5, pal.signal, 2);
          });
          ctx.globalAlpha = 1;
        }
        if (story === 'collapse') {
          // The bracket: the APART seconds of the thought experiment, on the stretch where the two packets are still apart.
          const bx = pad + 3, y1 = Y(APART_PICTURE);
          ctx.strokeStyle = pal.hot; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.moveTo(bx + 4, Y(0)); ctx.lineTo(bx, Y(0)); ctx.lineTo(bx, y1); ctx.lineTo(bx + 4, y1); ctx.stroke();
          text(`paths apart ${APART} s`, bx + 8, (Y(0) + y1) / 2, 'left', pal.hot, 600);
          const hit = latest?.landing.hit;
          if (hit) {
            const hx = X(hit.side === 'left' ? LEFT : RIGHT), hy = Y(APART_PICTURE * (hit.at / APART));
            ring(hx, hy, 6, pal.hot, 2); dot(ctx, hx, hy, 2, pal.hot);
            text('hit', hx + (hit.side === 'left' ? -10 : 10), hy, hit.side === 'left' ? 'right' : 'left', pal.hot, 600);
          }
        }

        // The screen: bright bands, predicted odds, then the dots.
        ctx.fillStyle = pal.rule; ctx.globalAlpha = 0.5;
        for (const [a, b] of bands) ctx.fillRect(X(a), bandTop, Math.max(1, X(b) - X(a)), bandH);
        ctx.globalAlpha = 1;
        ctx.strokeStyle = pal.ink; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(pad, bandTop + bandH + 0.5); ctx.lineTo(w - pad, bandTop + bandH + 0.5); ctx.stroke();
        text('screen', pad, bandTop + bandH + 13, 'left', pal.ink2, 600);
        text('middle', w / 2, bandTop + bandH + 13, 'center', pal.ink2);
        ctx.strokeStyle = pal.paper; ctx.lineWidth = 4.5; ctx.lineJoin = 'round';
        const curvePath = () => {
          ctx.beginPath();
          curve.forEach((c, i) => {
            const x = X(-VIEW + (2 * VIEW * i) / (curve.length - 1)), y = bandTop + bandH - 3 - c * (bandH - 8);
            if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y);
          });
          ctx.stroke();
        };
        curvePath();
        ctx.strokeStyle = pal.signal; ctx.lineWidth = 2.25; curvePath();

        const rad = Math.max(1.2, Math.min(2.2, w / 200));
        for (const r of recs) {
          const x = X(r.landing.x);
          if (Math.abs(r.landing.x) > VIEW) continue;
          const y = dotY(r), age = (now - r.t) / FRESH;
          if (age < 1) { dot(ctx, x, y, rad * (2.2 - 1.2 * Math.max(0, age)), pal.signal); continue; }
          if (r.landing.hit) { ctx.fillStyle = pal.hot; ctx.fillRect(x - rad, y - rad, 2 * rad, 2 * rad); }
          else dot(ctx, x, y, rad, pal.ink);
        }
        if (story === 'many-worlds' && latest) {
          const y = dotY(latest);
          for (const x of branches(screen, latest.shot.place).slice(1)) if (Math.abs(x) <= VIEW) ring(X(x), y, 4.5, pal.ink2, 1.5);
          if (Math.abs(latest.landing.x) <= VIEW) { dot(ctx, X(latest.landing.x), y, rad * 2.2, pal.signal); }
        } else if (latest && Math.abs(latest.landing.x) <= VIEW) {
          ring(X(latest.landing.x), dotY(latest), rad * 3, pal.signal, 1.5);
        }
      };

      const resize = () => {
        const w = canvas.getBoundingClientRect().width;
        if (!w) return;
        L = layout(w);
        canvas.style.height = `${L.h}px`;
        ({ ctx } = fit(canvas));
        pal = palette(); mono = token('--mono');
        buildImage(); buildCurve(); paint();
      };

      // ---- Words

      const stats = () => {
        const c = counts(), val = v(), pred = brightShare(val, shares);
        countOut.textContent = c.shots.toLocaleString('en');
        gotOut.textContent = c.shots ? percent(c.inBright / c.shots) : 'none yet';
        predOut.textContent = percent(pred);
        keepOut.textContent = percent(val, story === 'collapse');
        sizeOut.textContent = sizeText(k);
        sizeIn.setAttribute('aria-valuetext', sizeText(k));
        extra.textContent = KEYS[story];
        extra.hidden = !KEYS[story];
        fires.forEach((b) => (b.disabled = recs.length + queue >= CAP));
      };
      const say = () => {
        readout.textContent = describe(story, k, counts(), shares, lastRec())
          + (recs.length >= CAP ? ` The picture holds ${CAP.toLocaleString('en')} dots. Press Clear to start again.` : '');
      };

      // ---- Shots land

      const release = (t: number) => {
        const shot = newShot(Math.random);
        recs.push({ shot, x0: startOf(shot.place), landing: land(story, size(), shot, screen), t });
        lastLand = t;
      };

      const step = (now: number) => {
        raf = 0;
        const dt = last ? Math.min(now - last, 50) : 16;
        last = now;
        if (queue > 0) {
          acc += (RATE * dt) / 1000;
          const n = Math.min(queue, Math.floor(acc));
          acc -= n; queue -= n;
          for (let i = 0; i < n; i++) release(now);
          stats();
          if (queue === 0) say();
        }
        paint(now);
        if (seen && (queue > 0 || now - lastLand < FRESH)) raf = requestAnimationFrame(step); else last = 0;
      };
      const kick = () => { if (!raf && seen) raf = requestAnimationFrame(step); };

      const fire = (n: number) => {
        n = Math.min(n, CAP - recs.length - queue);
        if (n <= 0) return;
        if (reduceMotion() || !seen) {
          for (let i = 0; i < n; i++) release(-Infinity);
          stats(); paint(); say();
        } else if (n === 1) {
          release(performance.now()); stats(); paint(); kick(); say();
        } else {
          queue += n; acc = 0.75; kick();
        }
      };

      // A story or size change keeps every shot's numbers and re-reads them, so dots stay put unless the story says otherwise.
      const show = () => { relabel(); buildCurve(); stats(); paint(); };

      radios.forEach((r) => r.addEventListener('change', () => { if (r.checked) { story = r.value as Story; show(); say(); } }));
      sizeIn.addEventListener('input', () => { k = Number(sizeIn.value); show(); });
      sizeIn.addEventListener('change', say);
      fires.forEach((b) => b.addEventListener('click', () => fire(Number(b.dataset.fire))));
      clearBtn.addEventListener('click', () => { recs = []; queue = 0; acc = 0; stats(); paint(); say(); });

      // A reloaded page can keep the radio and slider values; start from what the controls show.
      stats();
      onResize(canvas, resize);
      onTheme(resize);
      onSeen(canvas, (s) => { seen = s; if (s) { buildImage(); paint(); kick(); } });
      resize();
      const first = describe(story, k, counts(), shares, null);
      if (!readout.textContent!.startsWith(first)) say();
    }
  }
  customElements.define('qce-five-stories', FiveStories);
</script>

<style>
  .stories { display: grid; gap: var(--s1); margin: 0; padding: 0; border: 0; min-width: 0 }
  legend { padding: 0; font-weight: 600 }
  .opts { display: flex; flex-wrap: wrap; gap: 0 var(--s4) }
  .opts label { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 600; cursor: pointer }
  .opts input { width: 1.25rem; height: 1.25rem; accent-color: var(--signal); margin: 0 }

  figure { display: grid; gap: var(--s2); margin: 0; min-width: 0 }
  canvas { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--r) }
  figcaption { display: grid; gap: var(--s2); max-width: var(--read); font-size: .9375rem; color: var(--ink-2) }
  .key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s4); font: 500 .875rem var(--mono) }
  .key > span { display: inline-flex; align-items: center; gap: .4rem }
  .key > span::before { content: ""; flex: none }
  .key > .kw::before { width: .45rem; height: .45rem; border-radius: 50%; background: var(--ink-2) }
  .key > .kc::before { width: 1.1rem; height: 2px; background: var(--signal) }
  .key > .kb::before { width: .9rem; height: .9rem; background: var(--rule); opacity: .6 }

  .stats { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); margin: 0 }
  .stats div { display: grid; gap: var(--s1) }
  .stats dt { font-size: .875rem; color: var(--ink-2) }
  .stats dd { margin: 0; font: 600 1.125rem var(--mono) }

  .control { display: grid; gap: var(--s1); max-width: 28rem }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3) }
  .hint, .note { max-width: var(--read); font-size: .9375rem; color: var(--ink-2) }
</style>

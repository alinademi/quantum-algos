---
// One ideal qubit, started as 0 and driven for a time, told two ways: the Schrödinger picture turns the state, the Heisenberg
// picture turns the measurement the other way. Both odds come from separate matrix math in sims/pictures.ts, and every dot is a Born rule draw.
import { COPIES, MEASURES, schrodingerP, heisenbergP, stateAt, axisVec, angles, ketText, opText, fixed, valueText, readout, type Drive, type Meas } from '../../lib/sims/pictures.ts';
const uid = 'tp-' + Math.random().toString(36).slice(2, 8);
const T0 = 60, D0: Drive = 'x', M0: Meas = 'Z';
const presets = [0, 90, 180, 270, 360];
const drives: [Drive, string][] = [['x', 'x axis'], ['h', 'halfway between x and z']];
const measures: [Meas, string][] = [['Z', 'Z: 0 or 1'], ['X', 'X: + or −'], ['Y', 'Y: +i or −i']];
const [up0, down0] = MEASURES[M0].results;
const gap0 = angles(D0, M0, T0);
---
<qce-two-pictures class="tool">
  <div class="time">
    <div class="row">
      <label for={`${uid}-t`}>Time, as the turn angle ωt</label>
      <output for={`${uid}-t`} class="doto">{T0}°</output>
    </div>
    <input id={`${uid}-t`} type="range" min="0" max="360" step="1" value={T0} aria-valuetext={valueText(D0, M0, T0)} />
    <div class="chips" role="group" aria-label="Preset times">
      {presets.map((d) => <button type="button" data-deg={d} aria-pressed={String(d === T0)}>{d}°</button>)}
    </div>
  </div>

  <div class="pick">
    <fieldset>
      <legend class="label">Drive axis</legend>
      <div class="chips">
        {drives.map(([v, text]) => <label><input type="radio" name={`${uid}-d`} value={v} checked={v === D0} />{text}</label>)}
      </div>
    </fieldset>
    <fieldset>
      <legend class="label">Measure</legend>
      <div class="chips">
        {measures.map(([v, text]) => <label><input type="radio" name={`${uid}-m`} value={v} checked={v === M0} />{text}</label>)}
      </div>
    </fieldset>
  </div>

  <div class="pics">
    <figure>
      <figcaption><b>Schrödinger picture</b>The state turns.</figcaption>
      <canvas data-pic="s" aria-hidden="true"></canvas>
      <p class="angle">Angle from the <span data-up>{up0}</span> end: <b data-angle="s">{Math.round(gap0.s)}°</b></p>
    </figure>
    <figure>
      <figcaption><b>Heisenberg picture</b>The measurement turns the other way.</figcaption>
      <canvas data-pic="h" aria-hidden="true"></canvas>
      <p class="angle">Angle from the <span data-up>{up0}</span> end: <b data-angle="h">{Math.round(gap0.h)}°</b></p>
    </figure>
  </div>

  <dl class="sums">
    <div>
      <dt>Schrödinger: move the state</dt>
      <dd><code>|ψ(t)⟩ = U|0⟩ = <span data-ket>{ketText(stateAt(D0, T0))}</span></code></dd>
      <dd><code>P(<span data-up>{up0}</span>) = |⟨<span data-up>{up0}</span>|ψ(t)⟩|² = <b data-ps>{fixed(schrodingerP(D0, M0, T0))}</b></code></dd>
    </div>
    <div>
      <dt>Heisenberg: move the measurement</dt>
      <dd><code><span data-m>{M0}</span><sub>H</sub>(t) = U†<span data-m>{M0}</span>U = <span data-op>{opText(axisVec(D0, M0, T0))}</span></code></dd>
      <dd><code>P(<span data-up>{up0}</span>) = (1 + ⟨0|<span data-m>{M0}</span><sub>H</sub>(t)|0⟩)/2 = <b data-ph>{fixed(heisenbergP(D0, M0, T0))}</b></code></dd>
    </div>
  </dl>

  <figure class="shots">
    <figcaption>{COPIES} fresh copies, each started as 0, driven for the same time, then measured once</figcaption>
    <canvas data-shots aria-hidden="true"></canvas>
    <p class="axis"><span>gave <span data-up>{up0}</span>: <b data-n-up>0</b></span><span>gave <span data-down>{down0}</span>: <b data-n-down>0</b></span></p>
  </figure>
  <div class="tool-controls">
    <button type="button" class="btn btn-sm btn-line" data-new>Measure {COPIES} new copies</button>
  </div>

  <p class="tool-readout" aria-live="polite">{readout(D0, M0, T0)}</p>
  <p class="key">On each sphere, faint dots only draw the sphere: up is |0⟩, right is |+i⟩, and |+⟩ points toward you. The blue arrow with a big filled dot is the state. The red line through the middle is the measurement axis: its ring marks the end for the first result (0, + or +i), and labels name both ends. The faint dark line is the drive axis. Small dots trace where the moving part has been since time 0. Below, blue dots (left pile) gave the first result and grey dots (right pile) gave the second. The dashed line on each pile is the Born rule prediction, the same in both pictures.</p>
  <p class="note">A simulation of an ideal qubit, started as 0, under a steady drive H = (ħω/2) n·σ, where n is the drive axis, so U = e<sup>−iHt/ħ</sup>. Time is shown as the turn angle ωt. Driven about x, the state only reaches one great circle, through |0⟩, |−i⟩, |1⟩ and |+i⟩. Driven about the tilted axis, it only reaches one smaller circle, through |0⟩ and |+⟩. The spheres and arrows are pictures of the math, not things you can measure. Kets show U|0⟩ as computed, global phase included. Each dot is one fresh copy measured once, with Born rule odds and your browser's random numbers. Both pictures give the same odds, so one batch serves both. Each copy keeps its own random draw, so a dot moves only when the odds pass it.</p>
</qce-two-pictures>

<script>
  import {
    COPIES, DRIVES, MEASURES, schrodingerP, heisenbergP, stateAt, stateVec, axisVec, angles, ketText, opText, fixed,
    plusCount, valueText, readout, view, project, spherePoints, trail, type Drive, type Meas, type Vec,
  } from '../../lib/sims/pictures.ts';
  import { fit, palette, token, reduceMotion, onResize, onTheme, onSeen, dot } from '../../lib/draw.ts';

  type Pane = { c: HTMLCanvasElement; ctx: CanvasRenderingContext2D | null; w: number; h: number };
  type Colors = ReturnType<typeof palette>;
  type Item = { d: number; x: number; y: number; r: number; color: string; a: number; ring?: boolean; halo?: boolean };

  // Drawing only: these dots draw the sphere and its equator. They are not states or shots.
  const CAM = view(25, 18);
  const SURFACE = spherePoints(220);
  const EQUATOR: Vec[] = Array.from({ length: 96 }, (_, k) => [Math.cos((k * Math.PI) / 48), Math.sin((k * Math.PI) / 48), 0]);
  const REVEAL = 900; // ms for a new batch to appear
  const TRAIL = 5; // degrees between trail dots
  const neg = (v: Vec): Vec => [-v[0], -v[1], -v[2]];

  class TwoPictures extends HTMLElement {
    connectedCallback() {
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s)!;
      const $$ = <T extends Element>(s: string) => [...this.querySelectorAll<T>(s)];
      const slider = $<HTMLInputElement>('input[type="range"]'), out = $<HTMLOutputElement>('output');
      const presets = $$<HTMLButtonElement>('[data-deg]');
      const radios = $$<HTMLInputElement>('input[type="radio"]');
      const pane = (c: HTMLCanvasElement): Pane => ({ c, ctx: null, w: 0, h: 0 });
      const picS = pane($('[data-pic="s"]')), picH = pane($('[data-pic="h"]')), pile = pane($('[data-shots]'));
      const panes = [picS, picH, pile];
      const say = $('.tool-readout');
      const still = reduceMotion();

      let deg = +slider.value;
      let d = (radios.find((r) => r.name.endsWith('-d') && r.checked)?.value ?? 'x') as Drive;
      let m = (radios.find((r) => r.name.endsWith('-m') && r.checked)?.value ?? 'Z') as Meas;
      // One fixed uniform draw per copy, so the batch stays the same batch while time moves.
      let us = Array.from({ length: COPIES }, () => Math.random());
      let shown = still ? COPIES : 0, raf = 0, t0 = -1, seen = false, first = true, speakAfter = false;

      /** One Bloch sphere. kind 's': the state moves and the axis stays. kind 'h': the state stays and the axis moves. */
      function sphere(p: Pane, col: Colors, kind: 's' | 'h') {
        const ctx = p.ctx!, w = p.w, cx = w / 2, cy = w / 2, fs = Math.round(Math.min(15, Math.max(11, w * 0.08)));
        const R = w / 2 - fs - 6, u = R / 100;
        ctx.clearRect(0, 0, p.w, p.h);
        if (R <= 0) return;
        const items: Item[] = [];
        const put = (v: Vec, r: number, color: string, a = 1, lift = 0, ring = false, halo = false) => {
          const s = project(v, CAM);
          items.push({ d: s.depth + lift, x: cx + R * s.x, y: cy - R * s.y, r, color, a, ring, halo });
        };
        const shade = (v: Vec, back: number, front: number) => back + ((front - back) * (project(v, CAM).depth + 1)) / 2;
        const line = (a: Vec, b: Vec, gap: number, r: number, color: string, alpha: number, lift: number) => {
          const n = Math.max(2, Math.round((Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]) * R) / gap));
          for (let i = 0; i <= n; i++) {
            const f = i / n;
            put([a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f], r, color, alpha, lift);
          }
        };

        // The sphere: an outline, faint surface dots (fainter at the back) and the equator.
        for (let k = 0; k < 120; k++) dot(ctx, cx + R * Math.cos((k * Math.PI) / 60), cy + R * Math.sin((k * Math.PI) / 60), Math.max(0.6, u * 0.7), col.rule);
        for (const v of SURFACE) put(v, Math.max(0.5, u * 0.8), col.ink2, shade(v, 0.1, 0.35));
        for (const v of EQUATOR) put(v, Math.max(0.6, u * 0.9), col.ink2, shade(v, 0.25, 0.7));

        // The drive axis, the measurement axis (ring at the end of the first result) and the trail of what moves.
        const n = DRIVES[d].n, ax = kind === 's' ? MEASURES[m].m : axisVec(d, m, deg);
        line(neg(n), n, 5, Math.max(0.7, u * 1), col.ink, 0.5, 0.001);
        line(neg(ax), ax, 4, Math.max(0.8, u * 1.3), col.hot, 0.9, 0.002);
        const ring = Math.max(3.5, u * 7);
        put(ax, ring, col.hot, 1, 0.05, true);
        put(neg(ax), Math.max(2, u * 3), col.hot, 1, 0.03);
        const path = kind === 's' ? trail(deg, TRAIL, (t) => stateVec(d, t)) : trail(deg, TRAIL, (t) => axisVec(d, m, t));
        for (const v of path) put(v, Math.max(1, u * 1.8), kind === 's' ? col.signal : col.hot, 0.75, 0.004);

        // The state: at time t in the Schrödinger picture, still at |0⟩ in the Heisenberg picture.
        const r = stateVec(d, kind === 's' ? deg : 0);
        line([0, 0, 0], r, 4, Math.max(1, u * 1.6), col.signal, 1, 0.01);
        put(r, Math.max(4, u * 7.5), col.signal, 1, 0.06, false, true);

        items.sort((a, b) => a.d - b.d);
        for (const it of items) {
          ctx.globalAlpha = it.a;
          if (it.ring) {
            dot(ctx, it.x, it.y, it.r, col.plate);
            ctx.strokeStyle = it.color; ctx.lineWidth = Math.max(1.5, u * 2);
            ctx.beginPath(); ctx.arc(it.x, it.y, it.r, 0, Math.PI * 2); ctx.stroke();
          } else {
            if (it.halo) dot(ctx, it.x, it.y, it.r + 2, col.plate);
            dot(ctx, it.x, it.y, it.r, it.color);
          }
        }
        ctx.globalAlpha = 1;

        // Labels name both ends of the measurement axis, just outside each end.
        const [one, two] = MEASURES[m].results;
        ctx.font = `600 ${fs}px ${token('--mono')}`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.lineWidth = 4; ctx.lineJoin = 'round';
        const label = (v: Vec, text: string, gapPx: number) => {
          const s = project(v, CAM), sx = s.x * R, sy = -s.y * R, len = Math.hypot(sx, sy);
          const [ux, uy] = len > R * 0.25 ? [sx / len, sy / len] : [1, 0];
          const half = ctx.measureText(text).width / 2;
          const x = Math.min(w - half - 1, Math.max(half + 1, cx + sx + ux * (gapPx + half)));
          const y = Math.min(w - fs / 2 - 1, Math.max(fs / 2 + 1, cy + sy + uy * (gapPx + fs / 2)));
          ctx.strokeStyle = col.plate; ctx.strokeText(text, x, y);
          ctx.fillStyle = col.ink; ctx.fillText(text, x, y);
        };
        label(ax, one, ring + 3);
        label(neg(ax), two, Math.max(2, u * 3) + 4);
      }

      /** The batch: copies that gave the first result on the left, the second on the right, with the Born rule prediction. */
      function piles(p: Pane, col: Colors, P: number) {
        const ctx = p.ctx!, half = p.w / 2, base = p.h - 4;
        ctx.clearRect(0, 0, p.w, p.h);
        const pitch = Math.min(Math.min(half - 16, 140) / 10, (base - 6) / 10, 12);
        if (pitch <= 0) return;
        const rad = Math.max(0.9, pitch * 0.36), wide = 10 * pitch, k = plusCount(us, P, shown);
        [{ n: k, pk: P, color: col.signal }, { n: shown - k, pk: 1 - P, color: col.ink2 }].forEach(({ n, pk, color }, i) => {
          const x0 = half * (i + 0.5) - wide / 2;
          for (let j = 0; j < n; j++) dot(ctx, x0 + ((j % 10) + 0.5) * pitch, base - (Math.floor(j / 10) + 0.5) * pitch, rad, color);
          ctx.fillStyle = col.rule; ctx.fillRect(x0, base + 1, wide, 1);
          const y = base - ((COPIES * pk) / 10) * pitch;
          ctx.strokeStyle = col.ink; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
          ctx.beginPath(); ctx.moveTo(x0 - 4, y); ctx.lineTo(x0 + wide + 4, y); ctx.stroke(); ctx.setLineDash([]);
        });
      }

      /** Text and pictures for the current time, drive and measurement. Not spoken: see speak(). */
      function update() {
        const P = schrodingerP(d, m, deg), M = MEASURES[m], a = angles(d, m, deg), k = plusCount(us, P, shown);
        out.textContent = `${deg}°`;
        slider.value = String(deg);
        slider.setAttribute('aria-valuetext', valueText(d, m, deg));
        presets.forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.deg! === deg)));
        $$('[data-up]').forEach((e) => { e.textContent = M.results[0]; });
        $$('[data-down]').forEach((e) => { e.textContent = M.results[1]; });
        $$('[data-m]').forEach((e) => { e.textContent = m; });
        $('[data-angle="s"]').textContent = `${Math.round(a.s)}°`;
        $('[data-angle="h"]').textContent = `${Math.round(a.h)}°`;
        $('[data-ket]').textContent = ketText(stateAt(d, deg));
        $('[data-op]').textContent = opText(axisVec(d, m, deg));
        $('[data-ps]').textContent = fixed(P);
        $('[data-ph]').textContent = fixed(heisenbergP(d, m, deg));
        $('[data-n-up]').textContent = String(k);
        $('[data-n-down]').textContent = String(shown - k);
        if (!picS.ctx) return;
        const col = palette();
        sphere(picS, col, 's');
        sphere(picH, col, 'h');
        piles(pile, col, P);
      }

      /** The live readout speaks only on settled changes: a released slider, a button or a radio. */
      const speak = () => { if (shown >= COPIES) say.textContent = readout(d, m, deg, plusCount(us, schrodingerP(d, m, deg))); };

      const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };
      /** Show the whole batch at once: for reduced motion, and when the tool leaves the screen. */
      const finish = () => { stop(); shown = COPIES; update(); if (speakAfter) { speakAfter = false; speak(); } };

      function frame(now: number) {
        raf = 0;
        if (t0 < 0) t0 = now; // time the reveal from its first frame
        shown = Math.min(COPIES, Math.max(0, Math.floor(((now - t0) / REVEAL) * COPIES)));
        if (shown >= COPIES) { finish(); return; }
        update();
        raf = requestAnimationFrame(frame);
      }
      /** A batch appears shot by shot. speakNow: read the result out when it is complete. */
      function reveal(speakNow: boolean) {
        stop(); speakAfter = speakNow;
        if (still || !seen) { finish(); return; }
        shown = 0; t0 = -1; update();
        raf = requestAnimationFrame(frame);
      }

      const setTime = (v: number, spoken: boolean) => { deg = v; update(); if (spoken) speak(); };
      slider.addEventListener('input', () => setTime(+slider.value, false));
      slider.addEventListener('change', () => setTime(+slider.value, true));
      presets.forEach((b) => b.addEventListener('click', () => setTime(+b.dataset.deg!, true)));
      radios.forEach((r) => r.addEventListener('change', () => {
        if (!r.checked) return;
        if (r.name.endsWith('-d')) d = r.value as Drive; else m = r.value as Meas;
        update(); speak();
      }));
      $('[data-new]').addEventListener('click', () => { us = Array.from({ length: COPIES }, () => Math.random()); reveal(true); });

      const size = () => { panes.forEach((p) => { const f = fit(p.c); p.ctx = f.ctx; p.w = f.w; p.h = f.h; }); update(); };
      onResize(this, size);
      onTheme(() => update());
      onSeen(this, (v) => {
        seen = v;
        if (v && first) { first = false; reveal(false); }
        else if (!v && raf) finish();
      });
      size();
    }
  }
  customElements.define('qce-two-pictures', TwoPictures);
</script>

<style>
  .time { display: grid; gap: var(--s2) }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3) }
  .row output { flex: none; font: 900 2rem/1 var(--dots) }
  .pick { display: grid; gap: var(--s4) }
  fieldset { display: grid; align-content: start; margin: 0; padding: 0; border: 0; min-width: 0 }
  legend { padding: 0; margin-bottom: var(--s2) }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s2) }
  .chips label, .chips button {
    position: relative; display: inline-grid; place-items: center; min-width: 3.25rem; min-height: 2.75rem; padding: 0 .8rem;
    border: 1.5px solid var(--rule); border-radius: var(--r); background: var(--paper); color: var(--ink); font: 500 .9375rem var(--mono); cursor: pointer;
  }
  .chips input { position: absolute; opacity: 0; width: 1px; height: 1px }
  .chips label:hover, .chips button:hover { border-color: var(--ink) }
  .chips label:has(:checked), .chips button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper) }
  .chips label:has(:focus-visible) { outline: 3px solid var(--signal); outline-offset: 2px }

  .pics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, auto); gap: var(--s2) var(--s3); max-width: 40rem }
  .pics figure { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: var(--s2); min-width: 0 }
  .pics canvas { aspect-ratio: 1; height: auto }
  figcaption { font-size: .875rem; line-height: 1.4; color: var(--ink-2) }
  figcaption b { display: block; color: var(--ink); font-weight: 600 }
  .angle { font: 500 .875rem var(--mono); color: var(--ink-2) }
  .angle b { color: var(--ink) }

  .sums { display: grid; gap: var(--s3); margin: 0 }
  .sums div { display: grid; gap: var(--s1); min-width: 0 }
  .sums dt { font-weight: 600 }
  .sums dd { margin: 0 }
  .sums code { font-size: .9375rem; overflow-wrap: anywhere }
  .sums sub { font-size: .72em }

  .shots { display: grid; gap: var(--s2); min-width: 0; max-width: 40rem }
  .shots figcaption { font-weight: 600; color: var(--ink) }
  .shots canvas { height: 9rem }
  .axis { display: grid; grid-template-columns: 1fr 1fr; text-align: center; font: 500 .9375rem var(--mono); color: var(--ink-2) }
  .axis b { color: var(--ink) }

  .key, .note { max-width: var(--read); font-size: .9375rem; color: var(--ink-2) }
  .note sup { font-size: .72em }

  @media (min-width: 40rem) {
    .pick { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) }
    .sums { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s4) }
    .shots canvas { height: 10rem }
  }
</style>

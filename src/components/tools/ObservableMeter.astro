---
// Measures fresh copies of a qubit with any real symmetric 2x2 matrix as the observable. Results are only its eigenvalues,
// and each shot is a Born-rule draw with odds |<v_k|ψ>|² along its eigenvectors, from sims/observables.ts.
import { PRESETS, STATES, ENTRY, BATCH, describe, calcText, ketText, matrixText, num } from '../../lib/sims/observables.ts';
const uid = 'om-' + Math.random().toString(36).slice(2, 8);
const start = PRESETS.find((p) => p.id === 'S')!.o;
const entries = [
  { key: 'a', text: 'Top-left entry' },
  { key: 'd', text: 'Bottom-right entry' },
  { key: 'b', text: 'Off-diagonal entries (both move together)' },
] as const;
---
<qce-observable-meter class="tool">
  <canvas aria-hidden="true"></canvas>

  <div class="panel">
    <fieldset>
      <legend class="label">Observable A</legend>
      <div class="chips" role="group" aria-label="Preset observables">
        {PRESETS.map((p) => <button type="button" data-preset={p.id} aria-pressed={String(p.id === 'S')}>{p.name}</button>)}
      </div>
      <p class="mat-row">
        <span class="mat-name">A =</span>
        <span class="mat" role="img" aria-label={`A has ${matrixText(start)}`}>
          <span data-cell="a">{num(start.a)}</span><span data-cell="b">{num(start.b)}</span><span data-cell="b">{num(start.b)}</span><span data-cell="d">{num(start.d)}</span>
        </span>
      </p>
      {entries.map((e) => (
        <div class="slider">
          <div class="row">
            <label for={`${uid}-${e.key}`}>{e.text}</label>
            <output for={`${uid}-${e.key}`} data-out={e.key}>{num(start[e.key])}</output>
          </div>
          <input id={`${uid}-${e.key}`} data-entry={e.key} type="range" min={ENTRY.min} max={ENTRY.max} step={ENTRY.step} value={start[e.key]} aria-valuetext={num(start[e.key])} />
        </div>
      ))}
    </fieldset>

    <fieldset>
      <legend class="label">Start state</legend>
      <div class="chips" role="group" aria-label="Preset start states">
        {STATES.map((s) => <button type="button" data-deg={s.deg} aria-pressed={String(s.deg === 0)}>{s.name}</button>)}
      </div>
      <div class="slider">
        <div class="row">
          <label for={`${uid}-turn`}>Turn the start state</label>
          <output for={`${uid}-turn`} data-out="turn">{ketText(0)}</output>
        </div>
        <p class="hint" id={`${uid}-hint`}>The angle in the picture, from |0⟩ toward |1⟩.</p>
        <input id={`${uid}-turn`} data-turn type="range" min="-90" max="90" step="1" value="0" aria-describedby={`${uid}-hint`} aria-valuetext={`0 degrees: ${ketText(0)}`} />
      </div>
    </fieldset>

    <div class="tool-controls">
      <button class="btn btn-sm" type="button" data-shots="1">Measure 1 copy</button>
      <button class="btn btn-sm" type="button" data-shots={BATCH}>Measure {BATCH} copies</button>
      <button class="btn btn-sm btn-line" type="button" data-clear disabled>Clear</button>
    </div>
  </div>

  <p class="calc" data-calc>{calcText(0, start)}</p>
  <p class="tool-readout" aria-live="polite">{describe(0, start, [0, 0])}</p>
  <p class="note">This is a simulated ideal qubit. Each shot measures a fresh copy of the start state, and its result is drawn at random by the Born rule. The top picture is the amplitude plane: across is the amplitude of |0⟩, up is the amplitude of |1⟩. It is not the Bloch sphere: here, orthogonal states such as |0⟩ and |1⟩ sit at right angles. The two lines through the middle are the eigenvectors of A, each marked with its eigenvalue: solid line and solid dots for the larger eigenvalue, dashed line and hollow rings for the smaller. The arrow ending in a large ring is the start state, and the dotted lines drop from its tip onto each eigenvector; how far from the middle they land is the size of that result's amplitude. Below, each result lands on a number line, and the dashed mark on each pile is shots × odds. The moving dots are only a picture of each copy jumping to an eigenvector. The tool uses real numbers only, real entries and real amplitudes, so every state it reaches lies in this one plane. Complex entries, as in the Pauli matrix Y, follow the same rules. Numbers are rounded to two decimals.</p>
</qce-observable-meter>

<script>
  import { PRESETS, sameSym, spectrum, stateAt, amplitudes, odds, after, shoot, room, expected, along, placePiles, describe, calcText, ketText, matrixText, num, RULER, CAP, COLS, ROWS, type Sym, type Bit } from '../../lib/sims/observables.ts';
  import { fit, palette, token, reduceMotion, onResize, onTheme, onSeen, dot } from '../../lib/draw.ts';

  const TAU = Math.PI * 2;
  /** Flight time of a picture dot, in ms, and how many shots join the piles per frame. */
  const FLY = 450, PER_FRAME = 3;
  type Pal = ReturnType<typeof palette>;

  class ObservableMeter extends HTMLElement {
    connectedCallback() {
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s)!;
      const $$ = <T extends Element>(s: string) => [...this.querySelectorAll<T>(s)];
      const canvas = $<HTMLCanvasElement>('canvas'), readout = $('.tool-readout'), calc = $('[data-calc]'), mat = $('.mat');
      const entrySliders = $$<HTMLInputElement>('[data-entry]'), turn = $<HTMLInputElement>('[data-turn]');
      const presetButtons = $$<HTMLButtonElement>('[data-preset]'), stateButtons = $$<HTMLButtonElement>('[data-deg]');
      const shotButtons = $$<HTMLButtonElement>('[data-shots]'), clear = $<HTMLButtonElement>('[data-clear]');

      let o: Sym = { ...PRESETS.find((p) => p.id === 'S')!.o }, deg = 0;
      let shots: Bit[] = [], shown = 0, counts: [number, number] = [0, 0];
      let flying: { bit: Bit; t0: number }[] = [];
      const ctx = canvas.getContext('2d')!;
      let W = 0, Hh = 0, raf = 0, seen = false;

      // ---- Words and controls

      /** Set text, keeping each ket like |0⟩ on one line (a line may break after "|"). */
      const put = (el: Element, text: string) => el.replaceChildren(...text.split(/(\|[^|⟩\s]{1,3}⟩)/).map((part, i) =>
        i % 2 ? Object.assign(document.createElement('span'), { className: 'ket', textContent: part }) : part));
      /** The live readout speaks only on release and on button presses, never on every slider step. */
      const say = () => put(readout, describe(deg, o, counts));
      const sync = () => {
        entrySliders.forEach((s) => {
          const k = s.dataset.entry as keyof Sym, v = num(o[k]);
          s.value = String(o[k]);
          s.setAttribute('aria-valuetext', k === 'b' ? `${v}, in both off-diagonal places` : v);
          $(`[data-out="${k}"]`).textContent = v;
        });
        $$('[data-cell]').forEach((c) => { c.textContent = num(o[(c as HTMLElement).dataset.cell as keyof Sym]); });
        mat.setAttribute('aria-label', `A has ${matrixText(o)}`);
        turn.value = String(deg);
        $('[data-out="turn"]').textContent = ketText(deg);
        turn.setAttribute('aria-valuetext', `${deg} degrees: ${ketText(deg)}`);
        presetButtons.forEach((b) => b.setAttribute('aria-pressed', String(sameSym(o, PRESETS.find((p) => p.id === b.dataset.preset)!.o))));
        stateButtons.forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.deg! === deg)));
        put(calc, calcText(deg, o));
        const full = shots.length >= CAP, lost = full && shotButtons.some((b) => b === document.activeElement);
        shotButtons.forEach((b) => { b.disabled = full; });
        clear.disabled = shots.length === 0;
        if (lost) clear.focus();
      };
      /** A new experiment: new observable or new start state, so the piles start empty. */
      const reset = () => {
        shots = []; shown = 0; counts = [0, 0]; flying = [];
        sync(); draw();
      };

      entrySliders.forEach((s) => {
        s.addEventListener('input', () => { o = { ...o, [s.dataset.entry as keyof Sym]: +s.value }; reset(); });
        s.addEventListener('change', say);
      });
      turn.addEventListener('input', () => { deg = +turn.value; reset(); });
      turn.addEventListener('change', say);
      presetButtons.forEach((b) => b.addEventListener('click', () => { o = { ...PRESETS.find((p) => p.id === b.dataset.preset)!.o }; reset(); say(); }));
      stateButtons.forEach((b) => b.addEventListener('click', () => { deg = +b.dataset.deg!; reset(); say(); }));
      clear.addEventListener('click', () => { reset(); say(); shotButtons[0].focus(); });
      shotButtons.forEach((b) => b.addEventListener('click', () => {
        const k = room(shots.length, +b.dataset.shots!);
        if (!k) return;
        shots.push(...shoot(odds(o, stateAt(deg)), k, Math.random));
        sync();
        if (reduceMotion() || !seen) { release(shots.length - shown, -Infinity); say(); draw(); }
        else kick();
      }));

      // ---- Shots join the piles

      const release = (k: number, now: number) => {
        for (let i = 0; i < k && shown < shots.length; i++, shown++) {
          const bit = shots[shown];
          counts[bit]++;
          if (now > -Infinity) flying.push({ bit, t0: now });
        }
      };
      const step = (now: number) => {
        raf = 0;
        release(PER_FRAME, now);
        flying = flying.filter((f) => now - f.t0 < FLY);
        draw(now);
        if (shown === shots.length && !flying.length) { say(); return; }
        if (seen) raf = requestAnimationFrame(step);
      };
      const kick = () => { if (!raf && seen) raf = requestAnimationFrame(step); };

      // ---- Drawing

      const ring = (x: number, y: number, r: number, color: string, lw = 1.2) => {
        ctx.strokeStyle = color; ctx.lineWidth = lw; ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.stroke();
      };
      /** Result hi is a solid signal dot, result lo a hollow ring: shape tells them apart, not only color. */
      const mark = (bit: Bit, x: number, y: number, r: number, C: Pal) =>
        bit ? ring(x, y, Math.max(0.6, r - 0.6), C.ink2, Math.min(2, Math.max(1, r * 0.55))) : dot(ctx, x, y, r, C.signal);
      /** Text with a halo in the plate color, so it reads over lines and dots. */
      const text = (s: string, x: number, y: number, color: string, C: Pal, font: string, align: CanvasTextAlign = 'center') => {
        ctx.font = font; ctx.textAlign = align; ctx.textBaseline = 'middle'; ctx.lineJoin = 'round';
        ctx.lineWidth = 4; ctx.strokeStyle = C.plate; ctx.strokeText(s, x, y);
        ctx.fillStyle = color; ctx.fillText(s, x, y);
      };

      const draw = (now = performance.now()) => {
        if (!W) return;
        const C = palette(), mono = token('--mono');
        ctx.clearRect(0, 0, W, Hh);
        const side = W >= 1.3 * Hh;
        const ph = side ? Hh : Math.min(W * 0.92, Hh * 0.52);
        const pw = side ? W * 0.46 : W;
        plane(0, 0, pw, ph, C, mono, now);
        meter(side ? pw : 0, side ? 0 : ph, side ? W - pw : W, side ? Hh : Hh - ph, C, mono);
      };

      /** The amplitude plane: the state, the two eigenvector lines and the state's shadow on each. */
      const plane = (bx: number, by: number, bw: number, bh: number, C: Pal, mono: string, now: number) => {
        const R = Math.max(30, Math.min(bw, bh) / 2 - 34), cx = bx + bw / 2, cy = by + bh / 2;
        const at = (x: number, y: number): [number, number] => [cx + R * x, cy - R * y];
        const sp = spectrum(o), s = stateAt(deg), sx = s[0].re, sy = s[1].re, [tx, ty] = at(sx, sy);

        // Unit circle and the two axes, as faint dots.
        const n = Math.max(24, Math.round((TAU * R) / 7));
        ctx.globalAlpha = 0.55;
        for (let k = 0; k < n; k++) dot(ctx, cx + R * Math.cos((k / n) * TAU), cy + R * Math.sin((k / n) * TAU), 1, C.ink2);
        ctx.globalAlpha = 0.3;
        for (let k = -12; k <= 12; k++) { dot(ctx, cx + (R * k) / 12, cy, 0.9, C.ink2); dot(ctx, cx, cy + (R * k) / 12, 0.9, C.ink2); }
        ctx.globalAlpha = 1;

        const ends: { x: number; y: number; bit: Bit; value: string }[] = [];
        if (!sp.degenerate) {
          const amps = amplitudes(o, s);
          ([1, 0] as const).forEach((k) => {
            const v = sp.vectors[k], vx = v[0].re, vy = v[1].re, sign = amps[k] < 0 ? -1 : 1;
            const [x0, y0] = at(-vx, -vy), [x1, y1] = at(vx, vy);
            // The eigenvector line: solid signal for hi, dashed ink for lo.
            ctx.strokeStyle = k ? C.ink2 : C.signal; ctx.lineWidth = 2; ctx.setLineDash(k ? [6, 4] : []);
            ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke(); ctx.setLineDash([]);
            // The shadow: from the center to the foot, the amplitude along this eigenvector.
            const [fx, fy] = at(amps[k] * vx, amps[k] * vy);
            ctx.globalAlpha = 0.3; ctx.lineWidth = 6; ctx.lineCap = 'round';
            ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(fx, fy); ctx.stroke();
            ctx.globalAlpha = 1; ctx.lineCap = 'butt';
            const steps = Math.max(2, Math.round(Math.hypot(tx - fx, ty - fy) / 5));
            for (let i = 1; i < steps; i++) dot(ctx, fx + ((tx - fx) * i) / steps, fy + ((ty - fy) * i) / steps, 1, C.ink);
            dot(ctx, fx, fy, 2.4, C.ink);
            const [ex, ey] = at(sign * vx, sign * vy);
            ends.push({ x: ex, y: ey, bit: k, value: num(sp.values[k]) });
          });
        }

        // The start state: an arrow from the center to a ring.
        ctx.strokeStyle = C.ink; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(tx, ty); ctx.stroke();
        ring(tx, ty, 9, C.ink, 2);

        // Eigenvector ends on the state's side, where a copy lands, marked like the piles.
        for (const e of ends) {
          if (e.bit) { ctx.fillStyle = C.plate; ctx.beginPath(); ctx.arc(e.x, e.y, 6, 0, TAU); ctx.fill(); ring(e.x, e.y, 5.5, C.ink2, 2.2); }
          else dot(ctx, e.x, e.y, 6.5, C.signal);
        }

        // Picture dots: each new shot flies from the start state to the eigenvector it is left in.
        for (const f of flying) {
          const t = Math.min(1, (now - f.t0) / FLY), e = 1 - (1 - t) ** 3;
          const v = sp.degenerate ? s : after(o, s, f.bit), [gx, gy] = at(v[0].re, v[1].re);
          ctx.globalAlpha = 1 - 0.5 * t;
          mark(f.bit, tx + (gx - tx) * e, ty + (gy - ty) * e, 3, C);
        }
        ctx.globalAlpha = 1;

        // Labels last: each eigenvalue beside its end, pushed out from the center and kept inside the box.
        for (const e of ends) {
          let dx = e.x - cx, dy = e.y - cy;
          const L = Math.hypot(dx, dy) || 1; dx /= L; dy /= L;
          const font = `700 14px ${mono}`; ctx.font = font;
          const tw = ctx.measureText(e.value).width;
          const lx = Math.min(bx + bw - tw / 2 - 2, Math.max(bx + tw / 2 + 2, e.x + dx * (12 + tw / 2)));
          const ly = Math.min(by + bh - 10, Math.max(by + 10, e.y + dy * 16));
          text(e.value, lx, ly, e.bit ? C.ink : C.signal, C, font);
        }
        // Axis names just outside the circle, left out when an eigenvalue label sits at the same end.
        const near = (x: number, y: number) => ends.some((e) => ((e.x - cx) * x + (cy - e.y) * y) / R > Math.cos(Math.PI / 5));
        if (!near(1, 0)) text('|0⟩', cx + R + 12, cy, C.ink2, C, `500 12px ${mono}`, 'left');
        if (!near(0, 1)) text('|1⟩', cx, cy - R - 11, C.ink2, C, `500 12px ${mono}`);
        if (sp.degenerate) text('Every vector is an eigenvector', cx, by + bh - 10, C.ink2, C, `500 12px ${mono}`);
        // The state's name, beside the middle of its arrow.
        const mx = cx + (tx - cx) * 0.55, my = cy + (ty - cy) * 0.55, nx = -(ty - cy) / R, ny = (tx - cx) / R;
        text('|ψ⟩', mx + nx * 14, my + ny * 14, C.ink, C, `600 13px ${mono}`);
      };

      /** The meter: a number line, with each result piled at its eigenvalue. */
      const meter = (bx: number, by: number, bw: number, bh: number, C: Pal, mono: string) => {
        const pad = 14, left = bx + pad, right = bx + bw - pad, X = (v: number) => left + along(v) * (right - left);
        const base = by + bh - 44, lift = 14, top = by + 26, floor = base - lift;
        const pitch = Math.max(2, Math.min(9, (floor - top) / ROWS, (right - left) / 2.4 / COLS));
        const gw = pitch * COLS, r = pitch * 0.36;
        const sp = spectrum(o), p = odds(o, stateAt(deg)), total = counts[0] + counts[1];
        const values = sp.degenerate ? [sp.values[0]] : sp.values;
        const labels = values.map((v, k) => `${num(v)}: ${counts[k]}`);

        text('Results', left, by + 12, C.ink2, C, `500 12px ${mono}`, 'left');

        // Pile centers: at their eigenvalues, pushed apart when close, kept inside.
        const labelFont = `600 13px ${mono}`; ctx.font = labelFont;
        const lw = labels.map((t) => ctx.measureText(t).width + 16);
        const half = Math.max(gw, ...lw) / 2, want = values.map(X);
        const xs = sp.degenerate
          ? [Math.min(right - half, Math.max(left + half, want[0]))]
          : placePiles([want[0], want[1]], Math.max(gw, (lw[0] + lw[1]) / 2) + 14, left + half, right - half);

        // The number line: a tick at each whole number, labels at the even ones.
        ctx.strokeStyle = C.ink2; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(left, base); ctx.lineTo(right, base); ctx.stroke();
        for (let v = -RULER; v <= RULER; v++) {
          const x = X(v);
          ctx.strokeStyle = C.ink2; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x, base - 3); ctx.lineTo(x, base + 3); ctx.stroke();
          if (v % 2 === 0) text(num(v), x, base + 13, C.ink2, C, `500 11px ${mono}`);
        }

        values.forEach((v, k) => {
          const bit = k as Bit, gx = xs[k] - gw / 2;
          // A thin line from the pile down to its eigenvalue on the number line.
          ctx.strokeStyle = C.ink2; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(xs[k], floor + 3); ctx.lineTo(X(v), base - 6); ctx.stroke();
          ctx.globalAlpha = 0.5;
          for (let i = 0; i < COLS; i++) dot(ctx, gx + (i + 0.5) * pitch, floor + 2, 0.8, C.ink2);
          ctx.globalAlpha = 1;
          for (let i = 0; i < counts[k]; i++) mark(bit, gx + ((i % COLS) + 0.5) * pitch, floor - (Math.floor(i / COLS) + 0.5) * pitch, r, C);
          if (total) {
            const y = floor - (expected(total, p[k]) / COLS) * pitch;
            ctx.strokeStyle = C.ink; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
            ctx.beginPath(); ctx.moveTo(gx - 3, y); ctx.lineTo(gx + gw + 3, y); ctx.stroke(); ctx.setLineDash([]);
          }
          // The eigenvalue on the number line, marked like its results.
          if (bit) { ctx.fillStyle = C.plate; ctx.beginPath(); ctx.arc(X(v), base, 5, 0, TAU); ctx.fill(); ring(X(v), base, 4.5, C.ink2, 2); }
          else dot(ctx, X(v), base, 5, C.signal);
          // The pile's label: its eigenvalue and its count.
          ctx.font = labelFont;
          const tw = ctx.measureText(labels[k]).width, ly = by + bh - 11;
          mark(bit, xs[k] - tw / 2 - 4, ly, 4, C);
          text(labels[k], xs[k] + 6, ly, C.ink, C, labelFont);
        });
      };

      const resize = () => { const f = fit(canvas); W = f.w; Hh = f.h; draw(); };
      onResize(canvas, resize);
      onTheme(() => draw());
      onSeen(canvas, (v) => { seen = v; if (v && (shown < shots.length || flying.length)) kick(); });
      sync();
      say();
      resize();
    }
  }
  customElements.define('qce-observable-meter', ObservableMeter);
</script>

<style>
  canvas { height: auto; aspect-ratio: 3 / 5; max-height: 34rem }
  .panel { display: grid; gap: var(--s4); align-items: start }
  fieldset { display: grid; align-content: start; gap: var(--s3); margin: 0; padding: 0; border: 0; min-width: 0 }
  legend { padding: 0; margin-bottom: var(--s3) }
  .chips { display: flex; flex-wrap: wrap; align-content: flex-start; gap: var(--s2) }
  .chips button {
    display: inline-grid; place-items: center; min-width: 3.25rem; min-height: 2.75rem; padding: 0 .9rem;
    border: 1.5px solid var(--rule); border-radius: var(--r); background: var(--paper); color: var(--ink); font: 500 1rem var(--mono); cursor: pointer;
  }
  .chips button:hover { border-color: var(--ink) }
  .chips button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper) }
  .mat-row { display: flex; align-items: center; gap: var(--s3); font: 500 1rem var(--mono) }
  .mat { display: inline-grid; grid-template-columns: repeat(2, minmax(2.5rem, auto)); gap: .15rem var(--s3); padding: .3rem .7rem; border-inline: 2px solid var(--ink); border-radius: .5rem; text-align: right }
  .mat [data-cell="b"] { text-decoration: underline 2px var(--signal); text-underline-offset: .25em }
  .slider { display: grid; gap: var(--s1) }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 var(--s3) }
  .row output { white-space: nowrap }
  input { margin: 0 }
  .hint { font-size: .9375rem; color: var(--ink-2) }
  .calc { max-width: var(--read); font: 500 .9375rem/1.5 var(--mono); color: var(--ink) }
  .note { max-width: var(--read); font-size: .9375rem; color: var(--ink-2) }
  .tool-readout :global(.ket), .calc :global(.ket) { white-space: nowrap }
  @media (min-width: 40rem) {
    canvas { aspect-ratio: auto; height: 24rem }
    .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s5) }
    .panel > .tool-controls { grid-column: 1 / -1 }
  }
</style>

---
// One qubit, started as 0 then a Hadamard gate. A global phase turns both amplitudes, a relative phase turns only the
// amplitude of 1. Two batches of fresh copies are measured by the Born rule: one right away, one after a second Hadamard gate.
import { SHOTS, PRESETS, globalText, relativeText } from '../../lib/sims/phase.ts';
const uid = 'pd-' + Math.random().toString(36).slice(2, 8);
const sliders = [
  { key: 'g', label: 'Global phase: turn both amplitudes', group: 'Set the global phase to', text: globalText(0) },
  { key: 'r', label: 'Relative phase: turn only the amplitude of 1', group: 'Set the relative phase to', text: relativeText(0, 0) },
];
---
<qce-phase-dials class="tool">
  <div class="views">
    <figure>
      <canvas data-view="a" aria-hidden="true"></canvas>
      <figcaption>Amplitude of 0 <span class="deg" data-deg-a>0°</span></figcaption>
    </figure>
    <figure>
      <canvas data-view="b" aria-hidden="true"></canvas>
      <figcaption>Amplitude of 1 <span class="deg" data-deg-b>0°</span></figcaption>
    </figure>
    <figure>
      <canvas data-view="bloch" aria-hidden="true"></canvas>
      <figcaption>Bloch sphere from above</figcaption>
    </figure>
  </div>
  <p class="ket"><code>|ψ⟩ = <span data-size-a>0.71</span>·e<sup>i<span data-ket-a>0</span>°</sup>|0⟩ + <span data-size-b>0.71</span>·e<sup>i<span data-ket-b>0</span>°</sup>|1⟩</code></p>
  <p class="key">These are pictures of the state, not things you can measure. Each amplitude is an arrow on the complex plane: right is +1, up is +i, and the ring is size 1. On the second dial, the faint arrow copies the amplitude of 0, and the arc from it is the relative phase. On the Bloch sphere seen from above (from the 0 pole), the right edge is |+⟩, the left edge is |−⟩ and the top edge is |+i⟩.</p>

  <div class="tool-controls">
    {sliders.map((s) => (
      <div class="dial">
        <div class="row">
          <label for={`${uid}-${s.key}`}>{s.label}</label>
          <output for={`${uid}-${s.key}`} data-out={s.key}>0°</output>
        </div>
        <input id={`${uid}-${s.key}`} data-in={s.key} type="range" min="0" max="360" step="1" value="0" aria-valuetext={s.text} />
        <div class="presets" role="group" aria-label={s.group}>
          {PRESETS.map((d) => <button type="button" data-set={s.key} data-deg={d} aria-pressed={String(d === 0)}>{d}°</button>)}
        </div>
      </div>
    ))}
    <button type="button" class="btn btn-sm" data-new>New batch of shots</button>
  </div>

  <div class="batches">
    <figure>
      <figcaption>Measure now</figcaption>
      <canvas data-batch="now" aria-hidden="true"></canvas>
      <p class="axis"><span>0: <b data-z="now">0</b></span><span>1: <b data-o="now">0</b></span></p>
    </figure>
    <figure>
      <figcaption>Hadamard gate, then measure</figcaption>
      <canvas data-batch="h" aria-hidden="true"></canvas>
      <p class="axis"><span>0: <b data-z="h">0</b></span><span>1: <b data-o="h">0</b></span></p>
    </figure>
  </div>
  <p class="tool-readout" aria-live="polite">The qubit started as 0, then a Hadamard gate, so it is |+⟩. Move a slider to turn a phase.</p>
  <p class="key">Each dot is one fresh copy of the qubit, measured once, with Born rule odds. Blue dots gave 0 (left pile), grey dots gave 1 (right pile). The dashed line on each pile marks the Born rule prediction for {SHOTS} copies. Each copy keeps its own random draw, so a dot moves only when the odds change.</p>
</qce-phase-dials>

<script>
  import { arg, type C } from '../../lib/quantum.ts';
  import { SHOTS, prepare, oddsNow, oddsAfterH, blochTop, polar, relativeDeg, zeros, pileGrid, globalText, relativeText, readout } from '../../lib/sims/phase.ts';
  import { fit, palette, reduceMotion, onResize, onTheme, onSeen, dot } from '../../lib/draw.ts';

  type Pane = { c: HTMLCanvasElement; ctx: CanvasRenderingContext2D | null; w: number; h: number };
  type Colors = ReturnType<typeof palette>;
  const REVEAL = 14; // ms per shot as a new batch appears
  const TAU = Math.PI * 2;

  /** A dotted ring of radius R. */
  function ring(ctx: CanvasRenderingContext2D, cx: number, cy: number, R: number, r: number, color: string) {
    const n = Math.max(24, Math.round((TAU * R) / 6));
    for (let k = 0; k < n; k++) dot(ctx, cx + R * Math.cos((k * TAU) / n), cy + R * Math.sin((k * TAU) / n), r, color);
  }

  /** A dotted line from (x0, y0) to (x1, y1). */
  function line(ctx: CanvasRenderingContext2D, x0: number, y0: number, x1: number, y1: number, gap: number, r: number, color: string) {
    const n = Math.max(1, Math.round(Math.hypot(x1 - x0, y1 - y0) / gap));
    for (let k = 0; k <= n; k++) dot(ctx, x0 + ((x1 - x0) * k) / n, y0 + ((y1 - y0) * k) / n, r, color);
  }

  /** The complex plane with a unit ring and dotted axes. Returns center and radius. */
  function plane(p: Pane, col: Colors) {
    const ctx = p.ctx!, cx = p.w / 2, cy = p.h / 2, R = Math.min(p.w, p.h) / 2 - 8;
    ctx.clearRect(0, 0, p.w, p.h);
    line(ctx, cx - R, cy, cx + R, cy, 6, 0.9, col.rule);
    line(ctx, cx, cy - R, cx, cy + R, 6, 0.9, col.rule);
    ring(ctx, cx, cy, R, 1.1, col.ink2);
    return { ctx, cx, cy, R };
  }

  /** An amplitude as a dotted arrow from the center, with a big dot at its tip. */
  function arrow(ctx: CanvasRenderingContext2D, cx: number, cy: number, R: number, a: C, r: number, color: string) {
    const x = cx + a.re * R, y = cy - a.im * R;
    line(ctx, cx, cy, x, y, 4.5, r, color);
    dot(ctx, x, y, r * 2.6, color);
  }

  class PhaseDials extends HTMLElement {
    connectedCallback() {
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s)!;
      const input = { g: $<HTMLInputElement>('[data-in="g"]'), r: $<HTMLInputElement>('[data-in="r"]') };
      const output = { g: $('[data-out="g"]'), r: $('[data-out="r"]') };
      const presets = [...this.querySelectorAll<HTMLButtonElement>('[data-set]')];
      const pane = (c: HTMLCanvasElement): Pane => ({ c, ctx: null, w: 0, h: 0 });
      const view = { a: pane($('[data-view="a"]')), b: pane($('[data-view="b"]')), bloch: pane($('[data-view="bloch"]')) };
      const batch = { now: pane($('[data-batch="now"]')), h: pane($('[data-batch="h"]')) };
      const panes = [view.a, view.b, view.bloch, batch.now, batch.h];
      const say = $('.tool-readout');
      const still = reduceMotion();
      const fresh = () => Array.from({ length: SHOTS }, () => Math.random());

      let g = 0, r = 0;
      let usNow = fresh(), usH = fresh(); // one fixed uniform draw per copy, per batch
      let shown = still ? SHOTS : 0, credit = 0, raf = 0, last = 0, seen = false, timer = 0;

      function dials(col: Colors, s: C[]) {
        const A = plane(view.a, col);
        if (A.R > 0) arrow(A.ctx, A.cx, A.cy, A.R, s[0], 1.3, col.signal);
        const B = plane(view.b, col);
        if (B.R > 0) {
          // The arc runs counterclockwise from the faint arrow (amplitude of 0) by the relative phase.
          const from = arg(s[0]), span = ((relativeDeg(s) ?? 0) * Math.PI) / 180, rr = B.R * 0.34;
          const n = Math.round((span * rr) / 4.5);
          for (let k = 0; n > 0 && k <= n; k++) { const t = from + (span * k) / n; dot(B.ctx, B.cx + rr * Math.cos(t), B.cy - rr * Math.sin(t), 1, col.ink); }
          arrow(B.ctx, B.cx, B.cy, B.R, s[0], 0.9, col.ink2);
          arrow(B.ctx, B.cx, B.cy, B.R, s[1], 1.3, col.signal);
        }
        const T = plane(view.bloch, col);
        if (T.R > 0) {
          const [x, y] = blochTop(s);
          dot(T.ctx, T.cx + T.R, T.cy, 3, col.ink2);
          dot(T.ctx, T.cx - T.R, T.cy, 3, col.ink2);
          dot(T.ctx, T.cx, T.cy - T.R, 3, col.ink2);
          dot(T.ctx, T.cx, T.cy + T.R, 3, col.ink2);
          line(T.ctx, T.cx, T.cy, T.cx + x * T.R, T.cy - y * T.R, 4.5, 1.3, col.signal);
          dot(T.ctx, T.cx + x * T.R, T.cy - y * T.R, 5, col.signal);
        }
      }

      function pile(p: Pane, z: number, p0: number, col: Colors) {
        const ctx = p.ctx!, half = p.w / 2, base = p.h - 4;
        ctx.clearRect(0, 0, p.w, p.h);
        const gr = pileGrid(Math.min(half - 14, 120), base - 6, SHOTS); // narrow piles, so heights compare
        if (!gr.pitch) return;
        const rad = Math.max(0.8, gr.pitch * 0.36), wide = gr.cols * gr.pitch;
        // Left pile: copies that gave 0. Right pile: copies that gave 1. The dashed line is the Born rule prediction.
        const piles = [{ k: z, pk: p0, color: col.signal }, { k: shown - z, pk: 1 - p0, color: col.ink2 }];
        piles.forEach(({ k, pk, color }, i) => {
          const x0 = half * (i + 0.5) - wide / 2;
          for (let j = 0; j < k; j++) dot(ctx, x0 + ((j % gr.cols) + 0.5) * gr.pitch, base - (Math.floor(j / gr.cols) + 0.5) * gr.pitch, rad, color);
          ctx.fillStyle = col.rule; ctx.fillRect(x0, base + 1, wide, 1);
          const y = base - ((SHOTS * pk) / gr.cols) * gr.pitch;
          ctx.strokeStyle = col.ink; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
          ctx.beginPath(); ctx.moveTo(x0 - 4, y); ctx.lineTo(x0 + wide + 4, y); ctx.stroke(); ctx.setLineDash([]);
        });
      }

      function update() {
        const s = prepare(g, r), pNow = oddsNow(s)[0], pH = oddsAfterH(s)[0];
        const zNow = zeros(usNow, pNow, shown), zH = zeros(usH, pH, shown);
        const a = polar(s[0]), b = polar(s[1]);
        $('[data-deg-a]').textContent = `${a.deg}°`; $('[data-deg-b]').textContent = `${b.deg}°`;
        $('[data-size-a]').textContent = a.size; $('[data-size-b]').textContent = b.size;
        $('[data-ket-a]').textContent = String(a.deg); $('[data-ket-b]').textContent = String(b.deg);
        $('[data-z="now"]').textContent = String(zNow); $('[data-o="now"]').textContent = String(shown - zNow);
        $('[data-z="h"]').textContent = String(zH); $('[data-o="h"]').textContent = String(shown - zH);
        if (!view.a.ctx) return;
        const col = palette();
        dials(col, s);
        pile(batch.now, zNow, pNow, col);
        pile(batch.h, zH, pH, col);
      }

      // The readout speaks once a batch is complete and the sliders have settled.
      const speak = () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (shown < SHOTS) return;
          const s = prepare(g, r);
          say.textContent = readout(g, r, zeros(usNow, oddsNow(s)[0]), zeros(usH, oddsAfterH(s)[0]));
        }, 350);
      };

      function step(now: number) {
        raf = 0;
        credit += Math.max(0, Math.min(64, now - last)) / REVEAL; last = now;
        const k = Math.floor(credit); credit -= k;
        shown = Math.min(SHOTS, shown + k);
        update();
        if (shown < SHOTS) { if (seen) raf = requestAnimationFrame(step); }
        else speak();
      }
      const kick = () => { if (!raf && seen && shown < SHOTS) { last = performance.now(); raf = requestAnimationFrame(step); } };

      const set = (key: 'g' | 'r', v: number) => {
        if (key === 'g') g = v; else r = v;
        input[key].value = String(v);
        output[key].textContent = `${v}°`;
        input.g.setAttribute('aria-valuetext', globalText(g));
        input.r.setAttribute('aria-valuetext', relativeText(g, r));
        presets.forEach((b) => { if (b.dataset.set === key) b.setAttribute('aria-pressed', String(+b.dataset.deg! === v)); });
        update(); speak();
      };

      input.g.addEventListener('input', () => set('g', +input.g.value));
      input.r.addEventListener('input', () => set('r', +input.r.value));
      presets.forEach((b) => b.addEventListener('click', () => set(b.dataset.set as 'g' | 'r', +b.dataset.deg!)));
      $('[data-new]').addEventListener('click', () => {
        usNow = fresh(); usH = fresh();
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        shown = still ? SHOTS : 0; credit = 0;
        update();
        if (still) speak(); else kick();
      });

      const size = () => { panes.forEach((p) => { const f = fit(p.c); p.ctx = f.ctx; p.w = f.w; p.h = f.h; }); update(); };
      onResize(this, size);
      onTheme(() => update());
      onSeen(this, (v) => { seen = v; if (v) kick(); });
      size();
      if (still) speak();
    }
  }
  customElements.define('qce-phase-dials', PhaseDials);
</script>

<style>
  .views { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s2); max-width: 36rem }
  figure { display: grid; gap: var(--s2); align-content: start; min-width: 0 }
  .views canvas { aspect-ratio: 1; height: auto }
  figcaption { font-size: .875rem; line-height: 1.35; color: var(--ink-2) }
  .deg { display: block; font: 500 .9375rem var(--mono); color: var(--ink) }
  .ket code { font-size: 1rem; overflow-wrap: anywhere }
  .ket sup { font-size: .72em }
  .key { max-width: var(--read); font-size: .875rem; color: var(--ink-2) }

  .tool-controls { display: grid; gap: var(--s4); align-items: start }
  .dial { display: grid; gap: var(--s1); min-width: 0 }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s2) }
  .row output { flex: none; font-size: 1.25rem }
  .presets { display: flex; flex-wrap: wrap; gap: var(--s2) }
  .presets button { min-width: 3.5rem; min-height: 2.75rem; padding: 0 var(--s3); border: 1.5px solid var(--rule); border-radius: var(--r); background: var(--paper); color: var(--ink); font: 500 1rem var(--mono); cursor: pointer }
  .presets button:hover { border-color: var(--ink) }
  .presets button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper) }
  [data-new] { justify-self: start }

  .batches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, auto); gap: var(--s2) var(--s3) }
  .batches figure { grid-row: span 3; grid-template-rows: subgrid }
  .batches figcaption { font-weight: 600; color: var(--ink) }
  .batches canvas { height: 9rem }
  .axis { display: grid; grid-template-columns: 1fr 1fr; text-align: center; font: 500 .9375rem var(--mono); color: var(--ink-2) }
  .axis b { color: var(--ink) }

  @media (min-width: 40rem) {
    .tool-controls { grid-template-columns: 1fr 1fr }
    [data-new] { grid-column: 1 / -1 }
    .batches canvas { height: 11rem }
  }
</style>

---
import { lab } from '../../lib/sims/qubit-routing.ts';
---
<qce-routing-map class="tool">
  <div class="tool-controls controls">
    {lab.controls.map(c=><label>{c.label} <select data-control={c.key}>{c.options.map(o=><option value={o.value}>{o.label}</option>)}</select></label>)}
    <label>Routing step <input data-step type="range" min="0" max="5" value="0" /><output data-position>Start</output></label>
    <button type="button" class="btn" data-next>Next step</button>
  </div>
  <canvas aria-hidden="true"></canvas>
  <p data-cost></p>
  <p class="tool-readout" aria-live="polite"></p>
  <p class="note">This map is a diagram of physical sites and logical wire labels, not measurements or a model of physical movement. Adjacent sites can interact in both directions. The readout gives the exact marginal probability of 1 at each physical site and the matrix check of the full route. No measurement is performed by the routing gates.</p>
</qce-routing-map>
<script>
  import { lab,placements,layoutTrace } from '../../lib/sims/qubit-routing.ts';
  import { probability } from '../../lib/sims/gate-lab.ts';
  import { fit,palette,dot,onResize,onTheme,onSeen,pct } from '../../lib/draw.ts';
  class RoutingMap extends HTMLElement{
    connectedCallback(){
      const $=<T extends Element>(s:string)=>this.querySelector<T>(s)!;
      const inputs=[...this.querySelectorAll<HTMLSelectElement>('[data-control]')],step=$<HTMLInputElement>('[data-step]'),canvas=$<HTMLCanvasElement>('canvas');let seen=true;
      const values=()=>Object.fromEntries(inputs.map(el=>[el.dataset.control!,el.value]));
      const trace=()=>{const v=values(),[a,b]=v.pair.split('→').map(Number);return layoutTrace(a,b,placements[v.layout]);};
      let steps=lab.run(values());
      const draw=()=>{if(!seen)return;const {ctx,w,h}=fit(canvas),p=palette(),row=trace()[+step.value];ctx.clearRect(0,0,w,h);
        const spacing=w/4,y=h/2,x=(i:number)=>(i+.5)*spacing;
        for(let i=0;i<3;i++){for(let k=0;k<=16;k++)dot(ctx,x(i)+spacing*k/16,y,1,p.ink2);}
        if(row.wires.length===2){const [a,b]=row.wires;for(let k=0;k<=20;k++)dot(ctx,x(a)+(x(b)-x(a))*k/20,y,1.7,p.signal);}
        for(let i=0;i<4;i++){
          ctx.fillStyle=p.paper;ctx.beginPath();ctx.arc(x(i),y,Math.min(23,spacing*.35),0,Math.PI*2);ctx.fill();ctx.strokeStyle=p.ink;ctx.stroke();
          ctx.fillStyle=p.ink;ctx.font='600 14px monospace';ctx.textAlign='center';ctx.fillText('q'+row.sites[i],x(i),y+5);
          ctx.font='11px monospace';ctx.fillText('site '+i,x(i),y-34);ctx.fillText(pct(probability(steps[+step.value].state!,i)),x(i),y+38);
        }
        ctx.fillStyle=p.ink;ctx.font='12px monospace';ctx.fillText(row.name==='Start'?'Initial layout':row.name==='CNOT'?'Control '+row.wires[0]+' → '+row.wires[1]:row.name+' at '+row.wires.join(', '),w/2,h-8);
      };
      const report=(announce:boolean)=>{const rows=trace(),i=+step.value,r=rows[i];$('[data-position]').textContent=i+' / '+(rows.length-1);step.setAttribute('aria-valuetext',i===0?'Initial layout':'Step '+i+': '+r.name);
        const v=values(),initial=[v.start,v.q1,v.q2,v.q3],operation=r.name==='CNOT'?'CNOT from control site '+r.wires[0]+' to target site '+r.wires[1]:r.name+' on sites '+r.wires.join(' and ');
        if(announce)$('.tool-readout').textContent='Started with logical inputs '+initial.map((x,j)=>'q'+j+' = |'+x+'⟩').join(', ')+', placement '+rows[0].sites.join(', ')+'. '+(i?'After '+operation+': ':'Initial layout: ')+r.sites.map((q,j)=>'site '+j+' holds q'+q+', P(1) '+pct(probability(steps[i].state!,j))).join('; ')+'.';
        $('[data-cost]').textContent=steps.at(-1)!.rows!.map(x=>x.label+': '+x.value).join(' · ');
        draw();
      };
      const reset=()=>{steps=lab.run(values());step.max=String(trace().length-1);step.value='0';report(true);};
      inputs.forEach(el=>el.addEventListener('change',reset));step.addEventListener('input',()=>report(false));step.addEventListener('change',()=>report(true));
      $('[data-next]').addEventListener('click',()=>{step.value=String((+step.value+1)%trace().length);report(true);});
      onResize(this,draw);onTheme(draw);onSeen(this,v=>{seen=v;if(v)draw();});reset();
    }
  }
  customElements.define('qce-routing-map',RoutingMap);
</script>
<style>
  qce-routing-map{display:grid;gap:var(--s3)}
  .controls{display:flex;flex-wrap:wrap;align-items:end;gap:var(--s2)}
  label{display:grid;flex:1 1 7rem;gap:var(--s1);min-width:0}
  select,input{min-height:2.75rem;font:inherit;color:var(--ink);background:var(--paper)}
  canvas{width:100%;height:10rem}
  .note{font-size:.875rem;color:var(--ink-2)}
</style>

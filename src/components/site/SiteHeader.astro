---
import Brand from './Brand.astro';
import { nav } from './nav.ts';
const here = Astro.url.pathname;
---
<header class="wrap bar">
  <Brand />
  <nav aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    <a class="btn btn-sm" href="/learn/superposition/">Try superposition</a>
  </nav>
</header>

<style>
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s3); padding-block: var(--s3) }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s4) }
  nav a:not(.btn) { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; font-weight: 500 }
  nav a:not(.btn):hover, nav [aria-current] { text-decoration: underline }
</style>

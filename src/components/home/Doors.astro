---
// Three ways in: The Map (with the first line as a track), Words, and the newest blog post.
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import { stops, regions, lines, stop as get, isOpen } from '../../lib/curriculum.ts';
const first = lines[0].stops.map(get);
const post = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date)[0];
const day = (d: Date) => d.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<section class="section" aria-labelledby="doors-title">
  <div class="wrap">
    <SectionHead id="doors-title" title="Start anywhere">Fly through The Map, look up a word, or read the blog. Every page links to the others.</SectionHead>
    <div class="doors">
      <article class="door door-map">
        <ol class="mini-track" aria-hidden="true">{first.map((s) => <li class:list={{ open: isOpen(s.id) }} style={`--c: var(--r-${s.region})`}>{s.name}</li>)}</ol>
        <div>
          <p class="label">{stops.size} stops · {regions.length} regions · {lines.length} lines</p>
          <h3><a href="/map/">The Map</a></h3>
          <p>Every topic in quantum computing. Regions say what a topic is. Lines show the order to learn it.</p>
        </div>
      </article>
      <article class="door">
        <div class="mini-tiles" aria-hidden="true"><span>Am</span><span>Bs</span><span>En</span><span>Gr</span><span>H</span><span>Qb</span></div>
        <div>
          <p class="label">A to Z</p>
          <h3><a href="/words/">Words</a></h3>
          <p>Every term in one index. Each word points to the stop that teaches it.</p>
        </div>
      </article>
      {post && (
        <article class="door door-blog">
          <time class="doto" datetime={post.data.date.toISOString().slice(0, 10)}>{day(post.data.date)}</time>
          <div>
            <p class="label">From the blog</p>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<style>
  .section { padding-block: var(--s7) 0 }
  .doors { display: grid; gap: var(--s4) }
  .door { position: relative; display: grid; gap: var(--s3); align-content: start; padding: var(--s4); border: 1px solid var(--rule); border-radius: var(--r); background: var(--paper); transition: border-color .2s, transform .2s }
  .door:hover { border-color: var(--ink); transform: translateY(-2px) }
  h3 { font-size: 1.75rem }
  h3 a { text-decoration: none }
  h3 a::after { content: ""; position: absolute; inset: 0 }
  .door p:not(.label) { color: var(--ink-2) }
  .mini-track { position: relative; display: grid; gap: .55rem; padding: var(--s3) var(--s3) var(--s3) 2.4rem; border-radius: calc(var(--r) - 4px); background: var(--plate); font-size: .9375rem; font-weight: 600 }
  .mini-track::before { content: ""; position: absolute; left: 1.05rem; top: 1.4rem; bottom: 1.4rem; width: 6px; background: radial-gradient(circle, var(--ink-2) 2.2px, transparent 2.6px) 50% 0 / 6px 9px repeat-y }
  .mini-track li { position: relative; color: var(--ink-2) }
  .mini-track li::before { content: ""; position: absolute; left: -1.6rem; top: .2rem; width: .9rem; height: .9rem; border: 2.5px solid var(--c); border-radius: 50%; background: var(--plate) }
  .mini-track li.open { color: var(--ink) }
  .mini-track li.open::before { background: var(--signal); border-color: var(--signal) }
  .mini-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule) }
  .mini-tiles span { display: grid; place-items: center; height: 72px; background: var(--paper); font: 900 1.9rem/1 var(--dots) }
  .door-blog time { display: grid; place-items: center; height: 145px; border-radius: calc(var(--r) - 4px); background: var(--plate); font-size: 2rem }
  @media (min-width: 40rem) { .doors { grid-template-columns: repeat(2, minmax(0, 1fr)) } .door-map { grid-column: 1 / -1 } }
  @media (min-width: 64rem) { .doors { grid-template-columns: 2fr 1fr 1fr } .door-map { grid-column: auto } }
</style>

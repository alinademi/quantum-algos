---
// Stations placed by hand on a 40px grid. Label side: a = above, b = below, r = right, l = left.
type Side = 'a' | 'b' | 'r' | 'l';
const stops: Record<string, { name: string; x: number; y: number; side: Side; href?: string }> = {
  qubit: { name: 'Qubit', x: 60, y: 80, side: 'a' },
  superposition: { name: 'Superposition', x: 180, y: 80, side: 'a', href: '/learn/superposition/' },
  measurement: { name: 'Measurement', x: 300, y: 80, side: 'a' },
  entanglement: { name: 'Entanglement', x: 420, y: 80, side: 'a' },
  x: { name: 'X gate', x: 60, y: 160, side: 'r' },
  hadamard: { name: 'Hadamard', x: 60, y: 240, side: 'r' },
  cnot: { name: 'CNOT', x: 140, y: 320, side: 'b' },
  circuits: { name: 'Circuits', x: 240, y: 320, side: 'b' },
  interference: { name: 'Interference', x: 360, y: 320, side: 'b' },
  grover: { name: 'Grover', x: 480, y: 320, side: 'b' },
  shor: { name: 'Shor', x: 560, y: 240, side: 'r' },
  decoherence: { name: 'Decoherence', x: 300, y: 160, side: 'r' },
  correction: { name: 'Error correction', x: 300, y: 240, side: 'l' },
  chips: { name: 'Real chips', x: 420, y: 240, side: 'b' },
  bb84: { name: 'BB84', x: 560, y: 160, side: 'r' },
  pq: { name: 'Post-quantum', x: 560, y: 320, side: 'r' },
};
const lines = [
  { name: 'Physics', c: 'physics', stops: ['qubit', 'superposition', 'measurement', 'entanglement'], path: '60,80 420,80' },
  { name: 'Gates', c: 'gates', stops: ['qubit', 'x', 'hadamard', 'cnot', 'circuits'], path: '60,80 60,240 140,320 240,320' },
  { name: 'Algorithms', c: 'algorithms', stops: ['circuits', 'interference', 'grover', 'shor'], path: '240,320 480,320 560,240' },
  { name: 'Hardware', c: 'hardware', stops: ['measurement', 'decoherence', 'correction', 'chips'], path: '300,80 300,240 420,240' },
  { name: 'Crypto', c: 'crypto', stops: ['entanglement', 'bb84', 'shor', 'pq'], path: '420,80 480,80 560,160 560,320' },
];
const shared = new Set(Object.keys(stops).filter((id) => lines.filter((l) => l.stops.includes(id)).length > 1));
const label = { a: [0, -20, 'middle'], b: [0, 28, 'middle'], r: [14, 5, 'start'], l: [-14, 5, 'end'] } as const;
---
<figure id="map">
  <div role="region" aria-label="Course map. Scrolls sideways on small screens." tabindex="0">
    <svg viewBox="0 30 680 330" aria-labelledby="map-title">
      <title id="map-title">Course map: 5 lines, 16 stops. Superposition is open now.</title>
      {lines.map((l) => <polyline points={l.path} style={`--c: var(--${l.c})`} />)}
      {Object.entries(stops).map(([id, s]) => {
        const [dx, dy, anchor] = label[s.side];
        const stop = [
          <circle cx={s.x} cy={s.y} r={shared.has(id) ? 9 : 6} />,
          <text x={s.x + dx} y={s.y + dy} text-anchor={anchor}>{s.name}</text>,
        ];
        return s.href ? <a href={s.href}>{stop}</a> : stop;
      })}
    </svg>
  </div>
  <ul>
    {lines.map((l) => <li style={`--c: var(--${l.c})`}>{l.name} <span>{l.stops.length} stops</span></li>)}
  </ul>
</figure>
